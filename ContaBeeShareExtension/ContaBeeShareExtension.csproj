<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifiers Condition="'$(OS)' != 'Windows_NT'">ios-arm64;iossimulator-arm64;iossimulator-x64</RuntimeIdentifiers>
    <OutputType>Library</OutputType>
    <IsAppExtension>true</IsAppExtension>
    <Registrar>static</Registrar>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>mx.contabee.app.shareextension</ApplicationId>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>ContaBeeShareExtension</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <BundleResource Include="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <CodesignKey>Apple Development: Created via API (489HK3K7TX)</CodesignKey>
    <CodesignProvision>ContaBee ShareExtension Development</CodesignProvision>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- La extensión debe poder resolver sus callbacks administrados desde el arranque.
         AOT-compilar todos los assemblies evita que el host invoque un wrapper cuyo
         método todavía no esté disponible en el intérprete. -->
    <UseInterpreter>false</UseInterpreter>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <CodesignKey>Apple Distribution: Neurofant Mexico  S.A.P.I. de C.V (X598HW3AYR)</CodesignKey>
    <CodesignProvision>ContaBee ShareExtension AppStore</CodesignProvision>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- La extensión no usa los módulos dinámicos de la aplicación principal. -->
    <MtouchLink>SdkOnly</MtouchLink>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

</Project>
