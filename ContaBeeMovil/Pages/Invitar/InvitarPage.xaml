<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:local="clr-namespace:ContaBeeMovil.Pages.Invitar"
             x:Class="ContaBeeMovil.Pages.Invitar.InvitarPage"
             x:DataType="local:InvitarPage"
             x:Name="Pagina"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Title="Invitar"
             Shell.TabBarIsVisible="False">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,16" Spacing="8">

            <Label Text="Invita a tus contactos a usar Contabee. Les enviaremos un correo con los enlaces para descargar la app."
                   Style="{StaticResource Body1}"
                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                   Margin="0,0,0,8" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Filas}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:FilaCorreo">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Stroke="{toolkit:AppThemeResource Accent1}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="Transparent"
                                        Padding="10,0">
                                    <Entry Text="{Binding Texto}"
                                           Placeholder="correo@ejemplo.com"
                                           PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                                           BackgroundColor="Transparent"
                                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                                           FontSize="15"
                                           Keyboard="Email"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False"
                                           TextChanged="OnCorreoTextChanged"
                                           Unfocused="OnCorreoUnfocused" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="{x:Static f:FluentUI.dismiss_20_regular}"
                                       FontFamily="FluentUI"
                                       FontSize="20"
                                       Padding="12"
                                       TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding PuedeQuitar, Source={x:Reference Pagina}, x:DataType=local:InvitarPage}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnQuitarTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Label Text="{Binding Error}"
                                   IsVisible="{Binding TieneErrorVisible}"
                                   Style="{StaticResource Caption1}"
                                   TextColor="{toolkit:AppThemeResource Error}"
                                   Margin="4,0,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" Padding="4,8"
                                   IsVisible="{Binding PuedeAgregar}">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAgregarTapped" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="{x:Static f:FluentUI.add_20_regular}"
                       FontFamily="FluentUI"
                       FontSize="20"
                       TextColor="{toolkit:AppThemeResource Primary}"
                       VerticalOptions="Center" />
                <Label Text="{Binding TextoAgregar}"
                       Style="{StaticResource Body1Strong}"
                       TextColor="{toolkit:AppThemeResource Primary}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button x:Name="BtnEnviar"
                    Text="Enviar"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Clicked="OnEnviarClicked"
                    HorizontalOptions="Center"
                    WidthRequest="220"
                    Margin="0,12,0,24" />

        </VerticalStackLayout>
    </ScrollView>

    <ActivityIndicator x:Name="Loader"
                       IsRunning="False"
                       Opacity="0"
                       InputTransparent="True"
                       HeightRequest="40"
                       WidthRequest="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       ZIndex="10"
                       Color="{toolkit:AppThemeResource Primary}" />
    </Grid>
</ContentPage>
