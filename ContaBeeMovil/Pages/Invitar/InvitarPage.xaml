<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:local="clr-namespace:ContaBeeMovil.Pages.Invitar"
             x:Class="ContaBeeMovil.Pages.Invitar.InvitarPage"
             x:DataType="local:InvitarPage"
             x:Name="Pagina"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Title="Invitar"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,16,24,8" Spacing="28">

                <!-- Encabezado -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Invita a tus contactos"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource PrimaryText}" />
                    <Label Text="Les enviamos un correo con los enlaces para descargar Contabee."
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                </VerticalStackLayout>

                <!-- Correos -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Correos"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource PrimaryText}" />
                        <Label Grid.Column="1"
                               Text="{Binding TextoContador}"
                               FontSize="13"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Filas}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FilaCorreo">
                                <VerticalStackLayout Spacing="6">
                                    <Border HeightRequest="52"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{toolkit:AppThemeResource CardBackground}"
                                            Padding="14,0,4,0">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding TieneErrorVisible}" Value="False">
                                                <Setter Property="Stroke" Value="{toolkit:AppThemeResource Accent1}" />
                                                <Setter Property="StrokeThickness" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding TieneErrorVisible}" Value="True">
                                                <Setter Property="Stroke" Value="{toolkit:AppThemeResource Error}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{x:Static f:FluentUI.mail_20_regular}"
                                                   FontFamily="FluentUI"
                                                   FontSize="20"
                                                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                                                   VerticalOptions="Center" />
                                            <Entry Grid.Column="1"
                                                   Text="{Binding Texto}"
                                                   Placeholder="correo@ejemplo.com"
                                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                                                   BackgroundColor="Transparent"
                                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                                   FontSize="16"
                                                   Keyboard="Email"
                                                   IsSpellCheckEnabled="False"
                                                   IsTextPredictionEnabled="False"
                                                   VerticalOptions="Center"
                                                   TextChanged="OnCorreoTextChanged"
                                                   Unfocused="OnCorreoUnfocused" />
                                            <Label Grid.Column="2"
                                                   Text="{x:Static f:FluentUI.checkmark_20_regular}"
                                                   FontFamily="FluentUI"
                                                   FontSize="20"
                                                   TextColor="{toolkit:AppThemeResource Success}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding EsValida}"
                                                   SemanticProperties.Description="Correo válido" />
                                            <Label Grid.Column="3"
                                                   Text="{x:Static f:FluentUI.dismiss_20_regular}"
                                                   FontFamily="FluentUI"
                                                   FontSize="18"
                                                   Padding="12"
                                                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                                                   VerticalOptions="Center"
                                                   SemanticProperties.Description="Quitar correo"
                                                   IsVisible="{Binding PuedeQuitar, Source={x:Reference Pagina}, x:DataType=local:InvitarPage}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnQuitarTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding Error}"
                                           IsVisible="{Binding TieneErrorVisible}"
                                           FontSize="13"
                                           TextColor="{toolkit:AppThemeResource Error}"
                                           Margin="4,0,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Agregar otro correo -->
                    <Border HeightRequest="52"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{AppThemeBinding Light=#C4C5C7, Dark=#5A5A5A}"
                            StrokeThickness="1.5"
                            StrokeDashArray="4,3"
                            BackgroundColor="Transparent"
                            Padding="0"
                            IsVisible="{Binding PuedeAgregar}"
                            SemanticProperties.Description="Agregar otro correo">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgregarTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                                    Padding="0"
                                    VerticalOptions="Center">
                                <Label Text="{x:Static f:FluentUIFilled.add_16_filled}"
                                       FontFamily="FluentUIFilled"
                                       FontSize="14"
                                       TextColor="#1E1E1E"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Agregar otro correo"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Pie fijo -->
        <VerticalStackLayout Grid.Row="1" Padding="24,12,24,24" Spacing="10"
                             BackgroundColor="{toolkit:AppThemeResource Background}">
            <Button x:Name="BtnEnviar"
                    Text="Enviar invitaciones"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="54"
                    CornerRadius="16"
                    FontSize="17"
                    IsEnabled="False"
                    ContentLayout="Left,10"
                    Clicked="OnEnviarClicked">
                <Button.ImageSource>
                    <FontImageSource Glyph="{x:Static f:FluentUI.send_20_regular}"
                                     FontFamily="FluentUI"
                                     Size="20"
                                     Color="#1E1E1E" />
                </Button.ImageSource>
            </Button>
            <Label Text="Corrige el correo marcado para continuar"
                   IsVisible="{Binding HayErrores}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
        </VerticalStackLayout>

        <ActivityIndicator x:Name="Loader"
                           Grid.RowSpan="2"
                           IsRunning="False"
                           Opacity="0"
                           InputTransparent="True"
                           HeightRequest="40"
                           WidthRequest="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="10"
                           Color="{toolkit:AppThemeResource Primary}" />
    </Grid>
</ContentPage>
