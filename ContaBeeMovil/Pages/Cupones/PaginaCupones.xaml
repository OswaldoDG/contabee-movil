<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ContaBee.Pages.Cupones.PaginaCupones"
    Title="Cupones"
    BackgroundColor="{toolkit:AppThemeResource Background}">

    <Grid RowDefinitions="Auto,1,*,Auto" Padding="0">
        <Grid x:Name="BusquedaSection"
              Grid.Row="0"
              BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
              Padding="16,10,16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border StrokeThickness="1"
                        Stroke="{toolkit:AppThemeResource Accent1}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{toolkit:AppThemeResource Background}"
                        HeightRequest="56"
                        VerticalOptions="Center"
                        Padding="14,8">
                    <Entry Placeholder="Código"
                           Text="{Binding CodigoCupon}"
                           ReturnType="Search"
                           PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           BackgroundColor="Transparent" />
                </Border>

                <Button Grid.Column="1"
                        Text="Buscar"
                        Command="{Binding BuscarCuponCommand}"
                        WidthRequest="120"
                        HeightRequest="56"
                        Padding="0"
                        CornerRadius="12"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        TextColor="{StaticResource Black}"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
            </Grid>
        </Grid>

        <BoxView Grid.Row="1"
                 HeightRequest="1"
                 Color="{toolkit:AppThemeResource Accent1}" />

        <CollectionView Grid.Row="2"
                        Margin="10,10"
                        ItemsSource="{Binding Cupones}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Padding="20">
                    <Label Text="No hay cupones disponibles"
                           HorizontalOptions="Center"
                           FontSize="16"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ElevatedCard}" Padding="10">
                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{toolkit:AppThemeResource Primary}"
                                     WidthRequest="4" CornerRadius="2"
                                     VerticalOptions="Fill" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}"
                                       Style="{StaticResource Body1}"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource Primary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label IsVisible="{Binding Aplicado}"
                                       Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TextoCuentaFiscalAplicacion}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource Primary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label FontSize="12"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Codigo}" />
                                            <Span Text=" - " />
                                            <Span Text="{Binding Descripcion, TargetNullValue='Sin descripción'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="Aplicar"
                                    IsVisible="{Binding Aplicado, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                                    TextColor="{StaticResource Black}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AplicarCuponCommand}"
                                    CommandParameter="{Binding .}"
                                    Padding="16,8"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                            <Label Grid.Column="2"
                                   IsVisible="{Binding Aplicado}"
                                   Text="{Binding Fecha, StringFormat='{0:dd/MM/yy}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              IsVisible="{Binding EstaCargando}"
              BackgroundColor="{toolkit:AppThemeResource Shadow}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>