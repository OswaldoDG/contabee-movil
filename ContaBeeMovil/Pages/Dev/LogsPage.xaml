<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:ContaBeeMovil.Models"
             x:Class="ContaBeeMovil.Pages.Dev.LogsPage"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Title="Logs"
             Shell.TabBarIsVisible="False">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="2">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                <Label Text="Logs"
                       Style="{StaticResource Body1Strong}"
                       FontSize="15"/>
                <Label Text="{Binding Logs.Count, StringFormat='{0} entradas'}"
                       Style="{StaticResource Caption1}"
                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                       FontSize="12" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Limpiar"
                    Style="{StaticResource CleanLogsButton}"
                    Clicked="OnLimpiarClicked"/>
        </Grid>
    </Shell.TitleView>

    <CollectionView ItemsSource="{Binding Logs}">

        <CollectionView.EmptyView>
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8">
                <Label Text="{x:Static f:FluentUI.document_text_20_regular}" FontFamily="FluentUI"
                             FontSize="48"
                             HorizontalOptions="Center"
                             TextColor="{toolkit:AppThemeResource SecondaryText}" />
                <Label Text="No hay logs registrados"
                       Style="{StaticResource Body1}"
                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:LogEntrada">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="3,*,Auto" Padding="0,8">

                        <!-- Accent strip by level -->
                        <BoxView Grid.Column="0"
                                 Color="{Binding ColorAccent}"
                                 VerticalOptions="Fill"/>

                        <!-- Content -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="12,0,8,0">

                            <!-- Level badge + timestamp -->
                            <HorizontalStackLayout Spacing="8">
                                <Border StrokeShape="RoundRectangle 4"
                                        BackgroundColor="{Binding ColorFondo}"
                                        StrokeThickness="0"
                                        Padding="6,2">
                                    <Label Text="{Binding Nivel}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ColorAccent}"/>
                                </Border>
                                <Label Text="{Binding Hora}"
                                       FontSize="11"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Message -->
                            <Label Text="{Binding Mensaje}"
                                   FontSize="12"
                                   FontFamily="OpenSansRegular"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                        <!-- Copy button -->
                        <Button Grid.Column="2"
                                BackgroundColor="Transparent"
                                Padding="8,0"
                                VerticalOptions="Center"
                                CommandParameter="{Binding TextoCompleto}"
                                Clicked="OnCopiarLogClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FluentUI"
                                                 Glyph="{x:Static f:FluentUI.copy_20_regular}"
                                                 Color="{toolkit:AppThemeResource PrimaryText}" />
                            </Button.ImageSource>
                        </Button>

                    </Grid>
                    <BoxView Style="{StaticResource Divider}" Margin="12,0,0,0"/>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
