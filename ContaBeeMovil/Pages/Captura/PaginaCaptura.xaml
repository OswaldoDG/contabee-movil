<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:models="clr-namespace:ContaBeeMovil.Models"
             x:Class="ContaBeeMovil.Pages.Captura.PaginaCaptura"
             Title="Captura"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             BackgroundColor="{toolkit:AppThemeResource Background}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="0,0,2,0">
            <Label Grid.Column="0"
                   Text="Captura"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                   VerticalOptions="Center" />

            <!-- Badge: solo cuando NO hay créditos de autoservicio. Banner simple original. -->
            <Border Grid.Column="1"
                    IsVisible="{Binding TieneCreditosAutoservicio, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    Padding="10,7"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding CreditosCaptura}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   VerticalOptions="Center" />
                    <Label Text="créditos"
                                   FontSize="12"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Badge de créditos de autoservicio (se muestra cuando TieneCreditosAutoservicio).
                 Se selecciona automáticamente; no es interactivo. -->
            <Border Grid.Column="1"
                    IsVisible="{Binding TieneCreditosAutoservicio}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    Padding="0"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,Auto" VerticalOptions="Center">
                    <!-- Sección derecha (ATRÁS): fondo claro + número.
                         Margin negativo: su borde izquierdo se mete debajo de la box de color. -->
                    <Border Grid.Column="1"
                            BackgroundColor="{toolkit:AppThemeResource Disabled}"
                            Stroke="Black"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="18,7,5,7"
                            Margin="-18,0,5,0"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding CreditosActivos}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   VerticalOptions="Center" />
                            <Label Text="créditos"
                                   FontSize="12"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Sección izquierda (AL FRENTE, con sombra): color del tipo + ícono + nombre -->
                    <Border Grid.Column="0"
                            BackgroundColor="{Binding ColorCreditoActivo}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,7"
                            ZIndex="1"
                            VerticalOptions="Center"
                            Margin="5">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="1,0" Radius="2" Opacity="0.25" />
                        </Border.Shadow>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Path Data="M3,8 H19 M15,4 L19,8 L15,12 M21,16 H5 M9,12 L5,16 L9,20"
                                  Stroke="{Binding BrushContrasteCredito}"
                                  StrokeThickness="2.1"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Aspect="Uniform"
                                  WidthRequest="17"
                                  HeightRequest="17"
                                  VerticalOptions="Center" />
                            <Label Text="{Binding TipoCreditoActivo}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{Binding ColorContrasteCredito}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Shell.TitleView>

    <!-- Grid raíz: contenido + overlay de envío encima -->
    <Grid Padding="0">

        <!-- ══════════════════════════════════════════════════════════════════════
             CONTENIDO PRINCIPAL
             ══════════════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="0">

            <!-- ── Zona de controles (scroll por si el teclado sube) ───────────── -->
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0" Padding="5,0,5,4">

                    <!-- 1. Barra RFC / CP -->
                    <views:RfcCpBarView Margin="-12,0" ConFondo="False" EnColumnas="True" Padding="5,0" />


                    <!-- 2+3. Forma de pago y Tarjeta -->
                    <Grid ColumnDefinitions="*,*"
                          Margin="0,8,0,0"
                          ColumnSpacing="8">

                        <!-- Forma de pago -->
                        <views:SelectorFlotante Grid.Column="0"
                                               x:Name="SelectorFormaPago"
                                               Titulo="Medio Pago" />

                        <!-- Tarjeta / Agregar tarjeta -->
                        <Grid Grid.Column="1">
                            <views:SelectorFlotante x:Name="SelectorTarjeta"
                                                   IsVisible="{Binding MostrarSelectorTarjeta}"
                                                   Titulo="Tarjeta" />
                            <Border IsVisible="{Binding MostrarBotonAgregarTarjeta}"
                                    HorizontalOptions="Fill"
                                    BackgroundColor="{toolkit:AppThemeResource Background}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1"
                                    Stroke="{toolkit:AppThemeResource Accent1}"
                                    Padding="0">
                                <Button Text="+ Tarjeta"
                                        HorizontalOptions="Fill"
                                        Command="{Binding IrAgregarTarjetaCommand}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        BackgroundColor="Transparent"
                                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                                        HeightRequest="44" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 4+5. Uso CFDI + Desglosar IEPS -->
                    <Grid ColumnDefinitions="*,*"
                          Margin="0,8,0,0"
                          ColumnSpacing="8">
                        <views:SelectorFlotante Grid.Column="0"
                                               x:Name="SelectorUsoCfdi"
                                               Titulo="Uso Factura" />
                        <Border Grid.Column="1"
                                BackgroundColor="{toolkit:AppThemeResource Background}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                Padding="4,0">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="0"
                                  VerticalOptions="Center">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding DesglosarIeps}"
                                          Color="{toolkit:AppThemeResource Primary}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Desglosar IEPS"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 6. Opciones de evidencia -->
                    <Grid ColumnDefinitions="*,*"
                          Margin="0,8,0,0"
                          ColumnSpacing="8">
                        <Border Grid.Column="0"
                                BackgroundColor="{toolkit:AppThemeResource Background}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                Padding="4,0">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="0"
                                  VerticalOptions="Center">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding SoloEvidencia}"
                                          Color="{toolkit:AppThemeResource Primary}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Sólo evidencia"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                IsVisible="{Binding MostrarCapturaRemota}"
                                BackgroundColor="{toolkit:AppThemeResource Background}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                Padding="4,0">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="0"
                                  VerticalOptions="Center">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding CapturaRemota}"
                                          Color="{toolkit:AppThemeResource Primary}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Captura remota"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 7. Notas adicionales -->
                    <Border Margin="0,8,0,0"
                            BackgroundColor="{toolkit:AppThemeResource Background}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            Padding="12,0">
                        <Entry Placeholder="Notas adicionales Opcional"
                               Text="{Binding NotasAdicionales}"
                               HeightRequest="44"
                               FontSize="14"
                               PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               BackgroundColor="Transparent" />
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── 7. Zona de capturas ─────────────────────────────────────────── -->
            <Grid Grid.Row="1">

                <!-- Estado vacío -->
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Grid.Row="0"
                                     IsVisible="{Binding TieneCapturas, Converter={StaticResource InvertedBoolConverter}}">
                    <mi:MauiIcon Icon="{mi:Material Icon=FileCopy}"
                                 IconSize="52"
                                 HorizontalOptions="Center"
                                 IconColor="{toolkit:AppThemeResource SecondaryText}" />
                    <Label Text="Sin Capturas"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    <Label Text="¡Vaya! Parece que no hay nada aquí"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                </VerticalStackLayout>

                <!-- Lista horizontal de capturas -->
                <CarouselView x:Name="CarruselCapturas"
                              ItemsSource="{Binding Capturas}"
                              Grid.Row="0"
                              Loop="False"
                              CurrentItem="{Binding CapturaSeleccionada, Mode=TwoWay}"
                              IsVisible="{Binding TieneCapturas}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="models:CapturaLote">
                            <Grid Margin="1,1"
                                  RowDefinitions="*,Auto"
                                  WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=CapturaItemWidth}"
                                  HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=CapturaItemHeight}"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Padding="20,10,20,10">

                                <!-- Imagen encerrada en border con sombra y esquinas redondeadas -->
                                <Border Grid.Row="0"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        BackgroundColor="{toolkit:AppThemeResource Background}"
                                        Padding="0">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.22" />
                                    </Border.Shadow>
                                    <Grid Padding="0">
                                        <Image Source="{Binding Path, Converter={StaticResource FilePathToImageConverter}}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />

                                        <!-- Botón eliminar: esquina superior derecha -->
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="0,10,10,0"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                BackgroundColor="#CC000000"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Padding="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=EliminarCapturaCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <mi:MauiIcon Icon="{mi:Material Icon=Delete}"
                                                         IconSize="20"
                                                         IconColor="White"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         InputTransparent="True" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=MostrarMontoTicketInput}"
                                        BackgroundColor="{toolkit:AppThemeResource Background}"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="{toolkit:AppThemeResource Accent1}"
                                        Padding="10,0">
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="$"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{toolkit:AppThemeResource PrimaryText}" />
                                        <Entry Grid.Column="1"
                                               Placeholder="{Binding MontoTitulo}"
                                               Text="{Binding MontoTexto, Mode=TwoWay}"
                                               Keyboard="Numeric"
                                               HeightRequest="42"
                                               FontSize="14"
                                               PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

            </Grid>

            <!-- ── Barra de acciones: sin capturas (Cancelar + Cámara al 50%) ── -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  Padding="12,8,12,12"
                  ColumnSpacing="8"
                  BackgroundColor="{toolkit:AppThemeResource Background}"
                  IsVisible="{Binding TieneCapturas, Converter={StaticResource InvertedBoolConverter}}">

                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                        BorderColor="{toolkit:AppThemeResource SecondaryText}"
                        BorderWidth="1.5"
                        CornerRadius="12"
                        HeightRequest="52"
                        Padding="0"
                        FontSize="15" />

                <Button x:Name="BtnCamaraSin"
                        Grid.Column="1"
                        Command="{Binding TomarFotoCommand}"
                        IsEnabled="{Binding EstaEnviando, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        TextColor="{toolkit:AppThemeResource OnPrimary}"
                        CornerRadius="12"
                        HeightRequest="52">
                    <Button.Shadow>
                        <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,3" Radius="6" Opacity="0.35" />
                    </Button.Shadow>
                </Button>

            </Grid>

            <!-- ── Barra de acciones: con capturas (Cancelar + Cámara + Enviar al 33%) ── -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,*"
                  Padding="8"
                  ColumnSpacing="8"
                  BackgroundColor="{toolkit:AppThemeResource Background}"
                  IsVisible="{Binding TieneCapturas}">

                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding EstaEnviando, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="Transparent"
                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                        BorderColor="{toolkit:AppThemeResource SecondaryText}"
                        BorderWidth="1.5"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="0"
                        FontSize="15" />

                <Button x:Name="BtnCamaraCon"
                        Grid.Column="1"
                        Command="{Binding TomarFotoCommand}"
                        IsEnabled="{Binding EstaEnviando, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        TextColor="{toolkit:AppThemeResource OnPrimary}"
                        CornerRadius="12"
                        HeightRequest="50">
                    <Button.Shadow>
                        <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,3" Radius="6" Opacity="0.35" />
                    </Button.Shadow>
                </Button>

                <Button Grid.Column="2"
                        Text="Enviar"
                        Command="{Binding EnviarCommand}"
                        IsEnabled="{Binding PuedeEnviar}"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        TextColor="{toolkit:AppThemeResource OnPrimary}"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="14,0"
                        FontSize="15"
                        FontAttributes="Bold"
                        ContentLayout="Left,6"
                        mi:MauiIcon.Value="{mi:Material Icon=Upload}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding PuedeEnviar}"
                                     Value="False">
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                            <Setter Property="Shadow" Value="{x:Null}" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.Shadow>
                        <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,3" Radius="6" Opacity="0.35" />
                    </Button.Shadow>
                </Button>

            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════════
             OVERLAY DE ENVÍO
             ══════════════════════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding EstaEnviando}"
              BackgroundColor="{toolkit:AppThemeResource Background}"
              InputTransparent="False">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="24"
                                 Padding="40">

                <Label Text="Enviando Capturas ..."
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{toolkit:AppThemeResource PrimaryText}" />

                <!-- Círculo de progreso -->
                <Grid WidthRequest="160" HeightRequest="160"
                      HorizontalOptions="Center">
                    <GraphicsView x:Name="CircularProgress"
                                  WidthRequest="160"
                                  HeightRequest="160"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                    <Label Text="{Binding EnviandoProgreso, StringFormat='{0:P0}'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{toolkit:AppThemeResource PrimaryText}" />
                </Grid>

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
