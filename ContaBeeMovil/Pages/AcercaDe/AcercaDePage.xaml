<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             x:Class="ContaBeeMovil.Pages.AcercaDe.AcercaDePage"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Barra superior personalizada ── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16"
              BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
              Padding="12,12">
            <Label Grid.Column="0"
                   Text="{x:Static f:FluentUI.arrow_left_24_regular}"
                   FontFamily="{x:Static f:FluentUI.FontFamily}"
                   FontSize="24"
                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAtrasTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Text="Acerca de"
                   Style="{StaticResource Body1Strong}"
                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- ── Tarjetas ── -->
        <VerticalStackLayout Grid.Row="1" Padding="10" Spacing="8">

            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVersionTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Image Grid.Column="1"
                           Source="logo512.png"
                           WidthRequest="40"
                           HeightRequest="40"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                        <Label Text="Contabee"
                               Style="{StaticResource Body1}"
                               FontAttributes="Bold" />
                        <Label x:Name="LabelVersion"
                               FontSize="12"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Label Grid.Column="1"
                                     Text="{x:Static f:FluentUIFilled.phone_20_filled}" FontFamily="FluentUIFilled"
                                     FontSize="22"
                                     TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                     VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                        <Label Text="ID del dispositivo"
                               Style="{StaticResource Body1}" />
                        <Label x:Name="LblIdDispositivo"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Label Grid.Column="1"
                                 Text="{x:Static f:FluentUIFilled.wifi_1_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                 VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="Conectado a internet"
                           Style="{StaticResource Body1}"
                           VerticalOptions="Center" />
                    <Label x:Name="IconoInternet"
                                 Grid.Column="3"
                                 Text="{x:Static f:FluentUIFilled.checkmark_circle_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Label Grid.Column="1"
                                 Text="{x:Static f:FluentUIFilled.cloud_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                 VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="Servicios Contabee"
                           Style="{StaticResource Body1}"
                           VerticalOptions="Center" />
                    <Label x:Name="LoaderServicios"
                           Grid.Column="3"
                           Text="..."
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource Primary}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           WidthRequest="28" />
                    <Label x:Name="IconoServicios"
                                 Grid.Column="3"
                                 Text="{x:Static f:FluentUIFilled.checkmark_circle_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 VerticalOptions="Center"
                                 IsVisible="False" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Label Grid.Column="1"
                                 Text="{x:Static f:FluentUIFilled.settings_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                 VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           FontSize="17"
                           Text="Carga actual"
                           Style="{StaticResource Body1}"
                           VerticalOptions="Center" />
                    <Label x:Name="LoaderCargaActual"
                           Grid.Column="3"
                           Text="..."
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource Primary}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           WidthRequest="100" />
                    <Label x:Name="LabelCargaActual"
                           Grid.Column="3"
                           Text="--"
                           FontSize="17"
                           Style="{StaticResource Body2Strong}"
                           TextColor="{toolkit:AppThemeResource Error}"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="End"
                           IsVisible="False"
                           WidthRequest="120" />
                </Grid>
            </Border>

            <!-- Logs (siempre visible) -->
            <Border Style="{StaticResource ElevatedCard}" Padding="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="4,Auto,*,Auto" ColumnSpacing="10">
                    <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />
                    <Label Grid.Column="1"
                                 Text="{x:Static f:FluentUIFilled.bug_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="22"
                                 TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                                 VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="Logs"
                           Style="{StaticResource Body1}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="3"
                                 Text="{x:Static f:FluentUI.chevron_right_20_regular}" FontFamily="FluentUI"
                                 FontSize="20"
                                 TextColor="{toolkit:AppThemeResource SecondaryText}"
                                 VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
