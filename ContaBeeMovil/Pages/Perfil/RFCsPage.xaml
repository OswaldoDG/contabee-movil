<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             x:Class="ContaBeeMovil.Pages.Perfil.RFCsPage"
             Title="Mis Cuentas Fiscales"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Shell.TitleColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.ForegroundColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.TabBarIsVisible="False">

    <Grid>
        <RefreshView x:Name="RefreshCuentas"
                     Refreshing="RefreshCuentas_Refreshing">
        <CollectionView x:Name="ListaCuentas" Margin="10,10"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                                <SwipeItemView Command="{Binding DeleteCommand}"
                                               IsVisible="{Binding PuedeEliminar}">
                                    <Border BackgroundColor="{toolkit:AppThemeResource Error}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            Padding="5"
                                            WidthRequest="{Binding SwipeItemWidth}">
                                        <Label Text="{x:Static f:FluentUI.delete_20_regular}"
                                               FontFamily="FluentUI"
                                               FontSize="24"
                                               TextColor="{toolkit:AppThemeResource OnPrimary}"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Style="{StaticResource ElevatedCard}" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                                <BoxView Grid.Column="0"
                                         BackgroundColor="{toolkit:AppThemeResource Primary}"
                                         WidthRequest="4" CornerRadius="2"
                                         VerticalOptions="Fill" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}"
                                           Style="{StaticResource Body1}"
                                           FontAttributes="Bold"
                                           IsVisible="{Binding TieneNombre}" />
                                    <Label Text="{Binding Rfc}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{toolkit:AppThemeResource Primary}" />
                                    <Label Text="{Binding Regimen}"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                             Text="{x:Static f:FluentUI.chevron_right_20_regular}" FontFamily="FluentUI"
                                             FontSize="22"
                                             TextColor="{toolkit:AppThemeResource SecondaryText}"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding EsPrimaria}" />
                                <Label Grid.Column="2"
                                             Text="{x:Static f:FluentUIFilled.person_20_filled}" FontFamily="FluentUIFilled"
                                             FontSize="22"
                                             TextColor="{toolkit:AppThemeResource SecondaryText}"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding EsSecundaria}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <!-- Overlay de carga -->
        <views:CargandoOverlay x:Name="LoadingOverlay"
                               IsVisible="False" />

        <!-- FAB agregar -->
        <Border x:Name="BtnAgregar"
                Style="{StaticResource FabBorder}"
                Margin="0,0,16,28">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="BtnAgregar_Clicked" />
            </Border.GestureRecognizers>
            <Label Text="{x:Static f:FluentUI.add_20_regular}" FontFamily="FluentUI"
                         Style="{StaticResource FabIcon}" />
        </Border>

    </Grid>
</ContentPage>
