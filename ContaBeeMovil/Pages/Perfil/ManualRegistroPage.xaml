<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             x:Class="ContaBeeMovil.Pages.Perfil.ManualRegistroPage"
             Title="Nueva cuenta fiscal"
             BackgroundColor="{toolkit:AppThemeResource Background}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12" Padding="16,8,16,12">
                <VerticalStackLayout Spacing="14">

                        <Entry x:Name="EntryName"
                               Placeholder="Nombre o Razón Social"
                               HeightRequest="44"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                               TextChanged="EntryName_TextChanged" />

                        <Label x:Name="LblNombreError"
                               TextColor="{toolkit:AppThemeResource Error}"
                               FontSize="12"
                               Margin="4,-8,0,0"
                               IsVisible="False" />

                        <Grid>
                            <Entry x:Name="EntryRfc"
                                   Placeholder="RFC"
                                   MaxLength="13"
                                   HeightRequest="44"
                                   Margin="0,0,56,0"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                                   TextChanged="EntryRfc_TextChanged"
                                   Unfocused="EntryRfc_Unfocused" />

                            <Label x:Name="LabelCounter"
                                   Text="0/13"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="RfcValidation">
                                        <VisualState x:Name="Empty">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="{toolkit:AppThemeResource SecondaryText}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Valid">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="{toolkit:AppThemeResource Success}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Invalid">
                                            <VisualState.Setters>
                                                <Setter Property="TextColor" Value="{toolkit:AppThemeResource Error}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Label>
                        </Grid>

                        <Label x:Name="LblRfcError"
                               TextColor="{toolkit:AppThemeResource Error}"
                               FontSize="12"
                               Margin="4,-8,0,0"
                               IsVisible="False" />

                        <views:SelectorFlotante x:Name="SelectorRegimen"
                                                Titulo="Regimen" />

                        <Label x:Name="LblRegimenError"
                               TextColor="{toolkit:AppThemeResource Error}"
                               FontSize="12"
                               Margin="4,-8,0,0"
                               IsVisible="False" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <views:SelectorFlotante x:Name="SelectorPersona"
                                                    Titulo="Persona"
                                                    Grid.Column="0" />

                            <Grid Grid.Column="1">
                                <Entry x:Name="EntryCp"
                                       Placeholder="Código Postal"
                                       Keyboard="Numeric"
                                       MaxLength="5"
                                       HeightRequest="44"
                                       Margin="0,0,44,0"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                                       TextChanged="EntryCp_TextChanged" />

                                <Label x:Name="LabelCpCounter"
                                       Text="0/5"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Margin="0,0,4,0"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CpValidation">
                                            <VisualState x:Name="Empty">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="{toolkit:AppThemeResource SecondaryText}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Valid">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="{toolkit:AppThemeResource Success}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Invalid">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="{toolkit:AppThemeResource Error}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Label>
                            </Grid>
                        </Grid>

                        <Label x:Name="LblCpError"
                               TextColor="{toolkit:AppThemeResource Error}"
                               FontSize="12"
                               Margin="4,-8,0,0"
                               IsVisible="False" />

                        <Label x:Name="LblDireccionError"
                               TextColor="{toolkit:AppThemeResource Error}"
                               FontSize="12"
                               Margin="4,-4,0,0"
                               IsVisible="False" />

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <CheckBox x:Name="ChkSinDireccion"
                                      Grid.Column="0"
                                      WidthRequest="24"
                                      HeightRequest="24"
                                      HorizontalOptions="Start"
                                      VerticalOptions="Start"
                                      Margin="-4,-6,0,0"
                                      CheckedChanged="ChkSinDireccion_CheckedChanged" />
                            <Label x:Name="LblSinDireccionTexto"
                                   Grid.Column="1"
                                   Text="No deseo proporcionar mi dirección"
                                   LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="Justify"
                                   VerticalOptions="Start"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}" />
                        </Grid>

                        <VerticalStackLayout x:Name="DireccionContainer" Spacing="14">
                            <Entry x:Name="EntryNombreVialidad"
                                   Placeholder="Calle"
                                   HeightRequest="44"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Entry x:Name="EntryNumExterior"
                                       Placeholder="No. Exterior"
                                       HeightRequest="44"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />
                                <Entry x:Name="EntryNumInterior"
                                       Grid.Column="1"
                                       Placeholder="No. Interior"
                                       HeightRequest="44"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />
                            </Grid>

                            <Entry x:Name="EntryColonia"
                                   Placeholder="Colonia"
                                   HeightRequest="44"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />

                            <Entry x:Name="EntryMunicipio"
                                   Placeholder="Municipio"
                                   HeightRequest="44"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />

                            <views:SelectorFlotante x:Name="SelectorEntidadFederativa"
                                                    Titulo="Entidad Federativa" />
                        </VerticalStackLayout>

                    <CheckBox x:Name="ChkCompartido"
                              IsChecked="True"
                              IsVisible="False" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1"
                             Padding="16,8,16,12"
                             Spacing="6"
                             BackgroundColor="{toolkit:AppThemeResource Background}">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button x:Name="BtnCancel"
                        Grid.Column="0"
                        Text="Cancelar"
                        BackgroundColor="Transparent"
                        BorderColor="{toolkit:AppThemeResource Accent1}"
                        BorderWidth="1"
                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                        CornerRadius="10"
                        HeightRequest="44"
                        Clicked="BtnCancel_Clicked" />
                <views:BotonCargando x:Name="BtnRegistrar"
                                     Grid.Column="1"
                                     Texto="Registrar"
                                     RadioEsquina="10"
                                     Altura="44"
                                     Clicked="BtnRegistrar_Clicked" />
            </Grid>
        </VerticalStackLayout>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="{toolkit:AppThemeResource Shadow}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
