<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.Perfil.ResumenLicenciaRFCPage"
             Title="Mis Créditos"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Shell.TitleColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.ForegroundColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.TabBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- RFC -->
                <Border Style="{StaticResource ElevatedCard}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="RFC:"
                               Style="{StaticResource Caption1}"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalOptions="Center" />
                        <Label x:Name="LblRfc"
                               Grid.Column="1"
                               Text="—"
                               Style="{StaticResource Body1}"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Los tres tipos de créditos -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <!-- Captura -->
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Captura"
                               Style="{StaticResource Caption1}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               Margin="4,0" />
                        <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                Padding="8,12"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="LblCreditosCaptura"
                                       Text="—"
                                       FontSize="36"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource Captura}" />
                                <Label Text="disponibles"
                                       Style="{StaticResource Caption1}"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Colaboración -->
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Colaboración"
                               Style="{StaticResource Caption1}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               Margin="4,0" />
                        <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                Padding="8,12"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="LblCreditosColab"
                                       Text="—"
                                       FontSize="36"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource Colab}" />
                                <Label Text="disponibles"
                                       Style="{StaticResource Caption1}"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Autoservicio -->
                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="Autoservicio"
                               Style="{StaticResource Caption1}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               Margin="4,0" />
                        <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                Padding="8,12"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="LblCreditosAuto"
                                       Text="—"
                                       FontSize="36"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource Auto}" />
                                <Label Text="disponibles"
                                       Style="{StaticResource Caption1}"
                                       HorizontalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="True"
              BackgroundColor="{toolkit:AppThemeResource Background}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
