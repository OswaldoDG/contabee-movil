<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.Perfil.ResumenLicenciaRFCPage"
             Title="Mis Créditos"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Shell.TitleColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.ForegroundColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.TabBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- RFC -->
                <Border Style="{StaticResource ElevatedCard}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="RFC:"
                               Style="{StaticResource Caption1}"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalOptions="Center" />
                        <Label x:Name="LblRfc"
                               Grid.Column="1"
                               Text="—"
                               Style="{StaticResource Body1}"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Créditos de captura -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Créditos de captura"
                           Style="{StaticResource Caption1}"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource SecondaryText}"
                           Margin="4,0" />
                    <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            StrokeThickness="1"
                            Padding="10,8"
                            HorizontalOptions="Center"
                            MinimumWidthRequest="140">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label x:Name="LblDisponibles"
                                   Text="—"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource Primary}" />
                            <Label Text="Disponibles"
                                   Style="{StaticResource Caption1}"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                    <!--<Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            StrokeThickness="1"
                            Padding="10,8"
                            HorizontalOptions="Center"
                            MinimumWidthRequest="140">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label x:Name="LblConsumidos"
                                   Text="—"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            <Label Text="Consumidos"
                                   Style="{StaticResource Caption1}"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label x:Name="LblTotal"
                           Text="de 0 en total"
                           Style="{StaticResource Caption1}"
                           HorizontalOptions="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />-->
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="True"
              BackgroundColor="{toolkit:AppThemeResource Background}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
