<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.Perfil.RegistrarRFCsPage"
             Title="Registrar Cuenta Fiscal"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Shell.TitleColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.ForegroundColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,1,*,Auto">

        <!-- Registro Manual -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="24,0"
                             Spacing="10"
                             VerticalOptions="Center">
            <Label Text="Registro manual"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="{toolkit:AppThemeResource PrimaryText}" />
            <Label Text="Sólo necesita ingresar los datos fiscales básicos."
                   FontSize="13"
                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
            <Border WidthRequest="72"
                    HeightRequest="72"
                    Margin="0,6,0,0"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="{toolkit:AppThemeResource Primary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="IconManual_Tapped" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static f:FluentUIFilled.edit_20_filled}" FontFamily="FluentUIFilled"
                             FontSize="32"
                             TextColor="{toolkit:AppThemeResource OnPrimary}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Separador -->
        <BoxView Grid.Row="1"
                 Margin="24,0"
                 Color="{toolkit:AppThemeResource Accent1}" />

        <!-- Registro QR -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="24,0"
                             Spacing="10"
                             VerticalOptions="Center">
            <Label Text="Registro QR"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="{toolkit:AppThemeResource PrimaryText}" />
            <Label Text="Utilice la cámara del dispositivo para leer el QR de su constancia de situación fiscal."
                   FontSize="13"
                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
            <Border WidthRequest="72"
                    HeightRequest="72"
                    Margin="0,6,0,0"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="{toolkit:AppThemeResource Primary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="IconQr_Tapped" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static f:FluentUIFilled.qr_code_20_filled}" FontFamily="FluentUIFilled"
                             FontSize="32"
                             TextColor="{toolkit:AppThemeResource OnPrimary}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="{toolkit:AppThemeResource Shadow}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Volver a inicio -->
        <Button x:Name="BtnVolverInicio"
                Grid.Row="3"
                Text="Volver a inicio"
                Margin="24,16,24,5"
                Clicked="VolverAInicio_Clicked"
                BackgroundColor="{toolkit:AppThemeResource Primary}"
                TextColor="{toolkit:AppThemeResource PrimaryText}"
                CornerRadius="10"
                HorizontalOptions="Center"
                IsVisible="False" />

    </Grid>
</ContentPage>
