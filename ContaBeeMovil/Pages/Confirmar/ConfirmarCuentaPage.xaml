<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.Confirmar.ConfirmarCuentaPage"
             Title="Bienvenido a Contabee"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{toolkit:AppThemeResource Background}">

    <NavigationPage.TitleView>
        <Grid HorizontalOptions="FillAndExpand">
            <Label Text="Bienvenido a Contabee"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{toolkit:AppThemeResource PrimaryText}" />
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,32"
                             Spacing="0"
                             VerticalOptions="Center">

                <!-- Ícono superior: cambia según estado -->
                <Grid HorizontalOptions="Center"
                      Margin="0,0,0,40">

                    <!-- Loading -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="True"
                                       IsVisible="True"
                                       Color="{toolkit:AppThemeResource Primary}"
                                       WidthRequest="80"
                                       HeightRequest="80"/>

                    <!-- Éxito -->
                    <Image x:Name="SuccessIcon"
                           IsVisible="False"
                           Source="logo512.png"
                           WidthRequest="90"
                           HeightRequest="90"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"/>

                    <!-- Error -->
                    <Border x:Name="ErrorIcon"
                            IsVisible="False"
                            WidthRequest="90"
                            HeightRequest="90"
                            StrokeShape="RoundRectangle 10"
                            Stroke="Transparent"
                            BackgroundColor="{toolkit:AppThemeResource Error}"
                            Padding="0"
                            HorizontalOptions="Center">
                        <Label Text="✕"
                               FontSize="44"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Título -->
                <Label x:Name="TituloLabel"
                       Text="Verificando tu cuenta..."
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12"/>

                <!-- Mensaje -->
                <Label x:Name="MensajeLabel"
                       Text="Por favor espera un momento."
                       FontSize="15"
                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,48"/>

                <!-- Botón Continuar -->
            <Button x:Name="ContinuarBtn"
                    Text="Continuar"
                    IsVisible="False"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    TextColor="{toolkit:AppThemeResource PrimaryText}"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="44"
                    HorizontalOptions="Center"
                    WidthRequest="220"
                    Clicked="OnContinuarClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>