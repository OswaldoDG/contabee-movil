<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.Login.PaginaLogin"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Login">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light=#fefdfc, Dark=#141414}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="{StaticResource LayoutPadding}">

        <!-- ======================================= -->
        <!-- HEADER: Logo + Welcome                  -->
        <!-- ======================================= -->
        <VerticalStackLayout x:Name="HeaderContainer"
                             Grid.Row="0"
                             Spacing="2"
                             HorizontalOptions="Center"
                             Padding="0,16,0,8">

            <Image x:Name="LogoImage"
                   Source="logo512.png"
                   WidthRequest="80"
                   HeightRequest="80"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="ContaBee logo">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoTapped" />
                </Image.GestureRecognizers>
            </Image>

            <Image Source="{AppThemeBinding Light=contabeenombreligth.png, Dark=contabeenombredark.png}"
                   HeightRequest="30"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="Bienvenido de nuevo"
                   Style="{StaticResource Body1}"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
        </VerticalStackLayout>

        <!-- ======================================= -->
        <!-- BODY: Form inside card + Links          -->
        <!-- ======================================= -->
        <VerticalStackLayout x:Name="FormContainer"
                             Grid.Row="1"
                             Spacing="8"
                             Padding="2,0"
                             VerticalOptions="Center"
                             IsEnabled="{Binding FormHabilitado}">

            <!-- Banner: cuenta no activada -->
            <Border IsVisible="{Binding CuentaNoActivada}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="{toolkit:AppThemeResource Warning}"
                    BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                    Padding="12,10"
                    Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{x:Static f:FluentUIFilled.mail_alert_20_filled}"
                           FontFamily="FluentUIFilled"
                           FontSize="22"
                           TextColor="{toolkit:AppThemeResource Warning}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensajeCuentaNoActivada}"
                           Style="{StaticResource Caption1}"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Correo Electronico -->
            <sf:SfTextInputLayout Hint="Correo electr&#243;nico"
                                  HasError="{Binding EmailRequerido}"
                                  ErrorText="El correo es requerido"
                                  LeadingViewPosition="Inside"
                                  ShowLeadingView="True">
                <sf:SfTextInputLayout.LeadingView>
                    <Label Text="{x:Static f:FluentUIFilled.mail_20_filled}" FontFamily="FluentUIFilled"
                                 Style="{StaticResource InputLeadingIcon}" />
                </sf:SfTextInputLayout.LeadingView>
                <Entry x:Name="EntryEmail"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       ReturnType="Next"
                       ClearButtonVisibility="WhileEditing"
                       SemanticProperties.Description="Correo electr&#243;nico" />
            </sf:SfTextInputLayout>

            <!-- Contrase&#241;a -->
            <sf:SfTextInputLayout Hint="Contrase&#241;a"
                                  EnablePasswordVisibilityToggle="True"
                                  HasError="{Binding PasswordRequerido}"
                                  ErrorText="La contrase&#241;a es requerida"
                                  LeadingViewPosition="Inside"
                                  ShowLeadingView="True">
                <sf:SfTextInputLayout.LeadingView>
                    <Label Text="{x:Static f:FluentUIFilled.lock_closed_20_filled}" FontFamily="FluentUIFilled"
                                 Style="{StaticResource InputLeadingIcon}" />
                </sf:SfTextInputLayout.LeadingView>
                <Entry x:Name="EntryPassword"
                       Text="{Binding Password}"
                       IsPassword="True"
                       ReturnType="Done"
                       SemanticProperties.Description="Contrase&#241;a" />
            </sf:SfTextInputLayout>

            <!-- Recordarme -->
            <HorizontalStackLayout HorizontalOptions="End"
                                   Spacing="4"
                                   Margin="0,-2,0,0">
                <CheckBox IsChecked="{Binding Recordarme}"
                          SemanticProperties.Description="Recordarme" />
                <Label Text="Recordarme"
                       VerticalOptions="Center"
                       Style="{StaticResource Caption1}"
                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
            </HorizontalStackLayout>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="Reg&#237;strate"
                        Command="{Binding IrARegistroCommand}"
                        Style="{toolkit:AppThemeResource Primary}"
                        SemanticProperties.Description="Reg&#237;strate">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FluentUIFilled"
                                         Glyph="{x:Static f:FluentUIFilled.person_add_20_filled}"
                                         Color="{toolkit:AppThemeResource OnPrimary}" />
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1"
                        Text="Ingresar"
                        Command="{Binding IngresarCommand}"
                        Style="{toolkit:AppThemeResource Primary}"
                        SemanticProperties.Description="Ingresar">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FluentUIFilled"
                                         Glyph="{x:Static f:FluentUIFilled.door_arrow_right_20_filled}"
                                         Color="{toolkit:AppThemeResource OnPrimary}" />
                    </Button.ImageSource>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="{toolkit:AppThemeResource OnPrimary}" />
                                        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver" />
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>

            </Grid>

            <!-- Links -->
            <VerticalStackLayout Spacing="20"
                                 HorizontalOptions="Fill"
                                 Margin="0,12,0,0">
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="4">
                    <Label Text="&#191;Olvidaste tu contrase&#241;a?"
                           VerticalOptions="Center"
                           Style="{StaticResource Caption1}"
                           TextColor="{toolkit:AppThemeResource PrimaryText}" />
                    <Label Text="Recup&#233;rala"
                           Style="{StaticResource LinkLabel}"
                           TextColor="{toolkit:AppThemeResource Primary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RecuperarContrasenaCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Vincularse a un equipo (loginless) -->
                <!-- Grid *,2*,* => la columna central mide lo mismo que un botón del grid superior (mitad del formulario) -->
                <Grid ColumnDefinitions="*,2*,*">
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#e3e3e5, Dark=#505050}"
                        HeightRequest="48"
                        Padding="12,0,16,0"
                        HorizontalOptions="Center"
                        SemanticProperties.Description="Vincular">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VincularmeCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="4"
                                 CornerRadius="2"
                                 Color="{toolkit:AppThemeResource Primary}"
                                 Margin="0,10"
                                 VerticalOptions="Fill" />
                        <Label Text="{x:Static f:FluentUIFilled.person_link_20_filled}"
                               FontFamily="FluentUIFilled"
                               FontSize="20"
                               TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                               VerticalOptions="Center" />
                        <Label Text="Vincular"
                               FontSize="16"
                               FontFamily="{OnPlatform WinUI=SegoeSemibold, iOS=.SFUI-SemiBold, MacCatalyst=.SFUI-SemiBold, Default=''}"
                               FontAttributes="{OnPlatform Default=None, Android=Bold}"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding EstaCargando}"
                           Opacity="{Binding EstaCargando, Converter={StaticResource BoolToOpacityConverter}}"
                           InputTransparent="True"
                           HeightRequest="40"
                           WidthRequest="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="10"
                           Color="{toolkit:AppThemeResource Primary}" />

        <!-- ======================================= -->
        <!-- FOOTER: Bottom Icons                    -->
        <!-- ======================================= -->
        <HorizontalStackLayout Grid.Row="02"
                               HorizontalOptions="Center"
                               Spacing="20"
                               Padding="0,0,0,0"
                               Margin="0">


            <Border >
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MostrarInfoCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static f:FluentUIFilled.info_24_filled}" FontFamily="FluentUIFilled"
                             SemanticProperties.Description="Informaci&#243;n"
                             TextColor="{toolkit:AppThemeResource Icon}"
                      FontSize="25"/>
            </Border>

            <Border x:Name="LogsButton"
                    IsVisible="False"
                    >
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogsClicked" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static f:FluentUIFilled.bug_20_filled}" FontFamily="FluentUIFilled"
                             SemanticProperties.Description="Logs"
                             TextColor="{toolkit:AppThemeResource Icon}"
                             FontSize="25"/>
            </Border>

        </HorizontalStackLayout>

    </Grid>
</ContentPage>
