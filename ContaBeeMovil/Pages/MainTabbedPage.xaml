<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ContaBeeMovil.Pages.MainTabbedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ContaBeeMovil.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:f="clr-namespace:Fonts"
    xmlns:vm="clr-namespace:ContaBeeMovil.Pages.Dashboard"
    xmlns:views="clr-namespace:ContaBeeMovil.Views"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{DynamicResource CurrentShellBarColor}"
    BackgroundColor="Transparent">

    <Shell.TitleView>
        <Grid HorizontalOptions="Fill">
            <Grid x:Name="MonthNavBar"
                  x:DataType="vm:DashboardViewModel"
                  ColumnDefinitions="Auto,*,Auto"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill"
                  Padding="0">
                <Label Grid.Column="0"
                       Text="{x:Static f:FluentUI.chevron_left_20_regular}"
                       FontFamily="FluentUI"
                       TextColor="{toolkit:AppThemeResource SecondaryIcon }"
                       FontSize="30"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MesAnteriorCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding MesAnioTexto}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Label Grid.Column="2"
                       Text="{x:Static f:FluentUI.chevron_right_20_regular}"
                       FontFamily="FluentUI"
                       TextColor="{toolkit:AppThemeResource SecondaryIcon}"
                       FontSize="30"
                       VerticalOptions="Center"
                       Margin="0,0,30,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MesSiguienteCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Label x:Name="LabelTitulo"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   Margin="0,0,60,0" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Banner de modo offline -->
        <Grid x:Name="BannerOffline"
              Grid.Row="0"
              IsVisible="False"
              BackgroundColor="{toolkit:AppThemeResource Warning}"
              Padding="10,6">
            <Label Text="Sin Conexión"
                   TextColor="{toolkit:AppThemeResource Info}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Área de contenido dinámico -->
        <ContentView x:Name="PageContainer"
                 Grid.Row="1" />

        <!-- Contenedor con fondo para la zona inferior -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 1,1,0,0"
                BackgroundColor="{toolkit:AppThemeResource Background}"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Radius="1"
                        Opacity="0.1"
                        Offset="0,-2" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,Auto">
                <views:RfcCpBarView Grid.Row="0" />
                <controls:SimpleTabBar x:Name="TabBar"
                                       Grid.Row="1"
                                       TabChanged="OnTabChanged" />
            </Grid>
        </Border>

        <!-- Overlay de carga a pantalla completa (reconciliación de sesión) -->
        <Grid x:Name="OverlayCargaGlobal"
              Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#D9000000">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
