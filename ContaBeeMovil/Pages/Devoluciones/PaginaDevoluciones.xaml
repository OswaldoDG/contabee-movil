<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             xmlns:f="clr-namespace:Fonts"
             x:Class="ContaBeeMovil.Pages.Devoluciones.PaginaDevoluciones"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Title="Devoluciones">

    <Border Grid.Row="0"
            Padding="0"
            BackgroundColor="{toolkit:AppThemeResource Accent1}"
            StrokeShape="RoundRectangle 1,1,0,0">
        <Grid RowDefinitions="Auto,*">

            <views:FiltrosDevolucionesView x:Name="PanelFiltros"
                                           BuscarCommand="{Binding BuscarDevolucionesCommand}" />

            <Grid Grid.Row="1">
                <views:ResultadosListaView
                    EstaCargando="{Binding EstaCargando}"
                    Elementos="{Binding Elementos}"
                    TotalEncontrados="{Binding TotalEncontrados}"
                    PaginaActual="{Binding PaginaActual}"
                    TotalPaginas="{Binding TotalPaginas}"
                    ConsultaEjecutada="{Binding ConsultaEjecutada}"
                    AnteriorCommand="{Binding PaginaAnteriorCommand}"
                    SiguienteCommand="{Binding PaginaSiguienteCommand}">
                    <views:ResultadosListaView.PlantillaItem>
                        <DataTemplate>
                            <Border Style="{StaticResource ElevatedCard}" Margin="6,4" Padding="12,10">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <Label Grid.Row="0"
                                           Text="{Binding Datos.Creacion, StringFormat='Fecha: {0:d/M/yyyy HH:mm}'}"
                                           Style="{StaticResource Caption1}" />

                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding CuentaFiscalRfc, StringFormat='RFC: {0}'}"
                                               Style="{StaticResource Body2Strong}"
                                               LineBreakMode="TailTruncation" />

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                BackgroundColor="{toolkit:AppThemeResource Alternate}"
                                                Padding="8,2">
                                            <Label Text="{Binding Datos.Estado}"
                                                   Style="{StaticResource Caption1}" />
                                        </Border>
                                    </Grid>

                                    <Label Grid.Row="2"
                                           Text="{Binding Datos.Monto, StringFormat='Monto: {0:C2}'}"
                                           Style="{StaticResource Body2Strong}" />

                                    <Label Grid.Row="3"
                                           Text="{Binding Datos.Descripcion}"
                                           Style="{StaticResource Body2}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </views:ResultadosListaView.PlantillaItem>
                </views:ResultadosListaView>

                <Button Text="{x:Static f:FluentUI.add_20_regular}"
                        FontFamily="FluentUI"
                        FontSize="20"
                        TextColor="#1A1A1A"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="10"
                        Padding="0"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,8,8"
                        Clicked="OnCrearDevolucionClicked"
                        ZIndex="10" />
            </Grid>
        </Grid>
    </Border>
</ContentPage>
