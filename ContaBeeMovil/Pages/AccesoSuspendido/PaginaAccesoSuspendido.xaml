<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Pages.AccesoSuspendido.PaginaAccesoSuspendido"
             Shell.NavBarIsVisible="False"
             Title="Acceso desactivado">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="16"
                         Padding="{StaticResource LayoutPadding}">

        <mi:MauiIcon Icon="{mi:Material Icon=LockClock}"
                     IconSize="72"
                     HorizontalOptions="Center"
                     IconColor="{toolkit:AppThemeResource SecondaryText}" />

        <Label Text="Tu acceso fue desactivado"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label Text="El administrador de la cuenta fiscal desactivó tu acceso. En cuanto lo reactive podrás continuar."
               Style="{StaticResource Body1}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{toolkit:AppThemeResource SecondaryText}" />

        <Button Text="Reintentar"
                Clicked="OnReintentar"
                IsEnabled="{Binding NoEstaCargando}"
                Style="{toolkit:AppThemeResource Primary}"
                Margin="0,8,0,0"
                SemanticProperties.Description="Reintentar acceso" />

        <Button Text="Volver a iniciar sesión"
                Clicked="OnVolverALogin"
                IsEnabled="{Binding NoEstaCargando}"
                Style="{toolkit:AppThemeResource Secondary}"
                SemanticProperties.Description="Volver a la pantalla de inicio de sesión" />

        <ActivityIndicator IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
