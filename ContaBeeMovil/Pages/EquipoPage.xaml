<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ContaBeeMovil.Pages.Equipo"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             xmlns:f="clr-namespace:Fonts"
             x:Class="ContaBeeMovil.Pages.EquipoPage"
             x:DataType="vm:EquipoViewModel"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Padding="0">

    <ContentPage.Resources>

        <!-- Template para usuarios vinculados: con gesto de deslizar para eliminar -->
        <DataTemplate x:Key="TemplateVinculado" x:DataType="vm:EquipoUsuarioItem">
            <SwipeView Margin="16,6">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView Command="{Binding DeleteCommand}">
                            <Border BackgroundColor="{toolkit:AppThemeResource Error}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="5"
                                    WidthRequest="{Binding SwipeItemWidth}">
                                <Label Text="{x:Static f:FluentUI.delete_20_regular}"
                                       FontFamily="FluentUI"
                                       FontSize="24"
                                       TextColor="{toolkit:AppThemeResource OnPrimary}"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />
                            </Border>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.LeftItems>

                <Border Margin="2"
                        Padding="10,5"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{toolkit:AppThemeResource Accent1}"
                        StrokeThickness="1"
                        BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConfigurarCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="5,*">
                        <BoxView Grid.Column="0"
                                 BackgroundColor="{toolkit:AppThemeResource Primary}"
                                 WidthRequest="4" CornerRadius="2"
                                 VerticalOptions="Fill">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding AsociacionActiva}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>

                        <Grid Grid.Column="1"
                              Padding="5"
                              ColumnDefinitions="56,*,Auto"
                              ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    StrokeShape="RoundRectangle 24"
                                    StrokeThickness="0"
                                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                                    VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding AsociacionActiva}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Iniciales}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource OnPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Nombre}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Email}"
                                       IsVisible="{Binding TieneEmail}"
                                       FontSize="12"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TipoCuentaTexto}"
                                       FontSize="12"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{x:Static f:FluentUI.chevron_right_20_regular}"
                                   FontFamily="FluentUI"
                                   FontSize="22"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                                   IsVisible="{Binding MostrarConfigurar}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </SwipeView>
        </DataTemplate>

        <!-- Template para el usuario en sesión: sin swipe, chip "Yo" junto al nombre -->
        <DataTemplate x:Key="TemplatePropio" x:DataType="vm:EquipoUsuarioItem">
            <Grid Margin="16,6">
                <Border Margin="0"
                        Padding="10,5"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{toolkit:AppThemeResource Accent1}"
                        StrokeThickness="1"
                        BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConfigurarCommand}" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="5,*">
                        <BoxView Grid.Column="0"
                                 BackgroundColor="{toolkit:AppThemeResource Primary}"
                                 WidthRequest="4" CornerRadius="2"
                                 VerticalOptions="Fill" />

                        <Grid Grid.Column="1"
                              Padding="5"
                              ColumnDefinitions="56,*,Auto"
                              ColumnSpacing="14">

                            <!-- Avatar con anillo dorado (diferenciador del usuario propio) -->
                            <Grid Grid.Column="0"
                                  WidthRequest="50"
                                  HeightRequest="50"
                                  VerticalOptions="Center">
                                <!-- Relleno dorado con iniciales -->
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="0"
                                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Iniciales}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{toolkit:AppThemeResource OnPrimary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <!-- Anillo superpuesto -->
                                <Border WidthRequest="55"
                                        HeightRequest="55"
                                        StrokeShape="RoundRectangle 26"
                                        Stroke="{toolkit:AppThemeResource Primary}"
                                        StrokeThickness="2"
                                        BackgroundColor="Transparent"
                                        InputTransparent="True"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Nombre}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                                           LineBreakMode="TailTruncation" />
                                    <Border BackgroundColor="{toolkit:AppThemeResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Label Text="Yo"
                                               FontSize="10"
                                               TextColor="{toolkit:AppThemeResource OnPrimary}"
                                               FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Email}"
                                       IsVisible="{Binding TieneEmail}"
                                       FontSize="12"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                                       LineBreakMode="TailTruncation" />
                                <!-- Sin etiqueta de tipo: es la tarjeta del usuario en
                                     sesion y el badge "Yo" ya lo identifica. -->
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{x:Static f:FluentUI.chevron_right_20_regular}"
                                   FontFamily="FluentUI"
                                   FontSize="22"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                                   IsVisible="{Binding MostrarConfigurar}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <vm:EquipoDataTemplateSelector x:Key="ItemSelector"
                                       UsuarioVinculadoTemplate="{StaticResource TemplateVinculado}"
                                       UsuarioPropioTemplate="{StaticResource TemplatePropio}" />

    </ContentPage.Resources>

    <Grid BackgroundColor="{toolkit:AppThemeResource Background}">

        <Border Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Accent1}"
                StrokeShape="RoundRectangle 1,1,0,0">
            <Grid RowDefinitions="Auto,*">

                <views:FiltrosEquipoView x:Name="PanelFiltros"
                                         BuscarCommand="{Binding BuscarEquipoCommand}" />

                <Grid Grid.Row="1">
                    <views:ResultadosListaView
                        EstaCargando="{Binding EstaCargando}"
                        Elementos="{Binding Elementos}"
                        TotalEncontrados="{Binding TotalEncontrados}"
                        PaginaActual="{Binding PaginaActual}"
                        TotalPaginas="{Binding TotalPaginas}"
                        ConsultaEjecutada="{Binding ConsultaEjecutada}"
                        AnteriorCommand="{Binding PaginaAnteriorCommand}"
                        SiguienteCommand="{Binding PaginaSiguienteCommand}"
                        ModoSeleccion="None"
                        PlantillaItem="{StaticResource ItemSelector}" />

        <!-- FAB expandible -->
        <VerticalStackLayout
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Margin="0,0,10,5"
                             Spacing="12">

            <!-- Sub-botones (visibles al expandir) -->
            <VerticalStackLayout x:Name="SubBotonesPanel"
                                 IsVisible="False"
                                 Opacity="0"
                                 Spacing="12"
                                 HorizontalOptions="End">

                <!-- Sin cuenta -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarSinCuentaCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border WidthRequest="80" HeightRequest="65"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HorizontalOptions="Center"
                            Padding="5">
                        <Border.Shadow>
                            <Shadow Brush="Black" Radius="6" Opacity="0.15" Offset="0,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static f:FluentUI.person_add_20_regular}" FontFamily="FluentUI"
                                     FontSize="28"
                                     TextColor="{toolkit:AppThemeResource OnPrimary}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                            <Label Text="Sin cuenta"
                           FontSize="11"
                           TextColor="{toolkit:AppThemeResource OnPrimary}"
                           HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Con Cuenta -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarConCuentaCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border WidthRequest="80" HeightRequest="65"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HorizontalOptions="Center"
                            Padding="5">
                        <Border.Shadow>
                            <Shadow Brush="Black" Radius="6" Opacity="0.15" Offset="0,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{x:Static f:FluentUIFilled.person_add_20_filled}" FontFamily="FluentUIFilled"
                                     FontSize="28"
                                     TextColor="{toolkit:AppThemeResource OnPrimary}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                            <Label Text="Con Cuenta"
                           FontSize="11"
                           TextColor="{toolkit:AppThemeResource OnPrimary}"
                           HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Botón FAB principal -->
            <Border WidthRequest="48" HeightRequest="48"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    HorizontalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="Black" Radius="10" Opacity="0.22" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFabCommand}" />
                </Border.GestureRecognizers>
                
                <Grid>
                                 <Label Text="{x:Static f:FluentUIFilled.add_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="20"
                                 TextColor="{toolkit:AppThemeResource OnPrimary}"
                                 IsVisible="{Binding FabColapsado}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                                <Label Text="{x:Static f:FluentUIFilled.chevron_down_20_filled}" FontFamily="FluentUIFilled"
                                 FontSize="20"
                                 TextColor="{toolkit:AppThemeResource OnPrimary}"
                                 IsVisible="{Binding FabExpandido}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>

                </Grid>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
