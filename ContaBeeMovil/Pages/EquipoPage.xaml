<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:ContaBeeMovil.Pages.Equipo"
             x:Class="ContaBeeMovil.Pages.EquipoPage"
             x:DataType="vm:EquipoViewModel"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Padding="0">

    <Grid BackgroundColor="{toolkit:AppThemeResource Background}"
          RowDefinitions="Auto,*">

        <!-- DEBUG: perfil info -->
        <Border Grid.Row="0"
                IsVisible="{Binding EsDev}"
                BackgroundColor="#222"
                Padding="10,6"
                Margin="8,4">
            <Label Text="{Binding PerfilInfo}"
                   TextColor="#00FF99"
                   FontSize="11"
                   FontFamily="Courier New"
                   LineBreakMode="WordWrap" />
        </Border>

        <Grid Grid.Row="1">

        <!-- Empty state -->
        <VerticalStackLayout IsVisible="{Binding MostrarVacio}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <mi:MauiIcon Icon="{mi:Material Icon=GroupOff}"
                         IconSize="56"
                         IconColor="{toolkit:AppThemeResource SecondaryText}"
                         HorizontalOptions="Center" />
            <Label Text="Sin usuarios vinculados"
                   TextColor="{toolkit:AppThemeResource SecondaryText}"
                   FontSize="15"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Lista de usuarios -->
        <RefreshView
                     Command="{Binding PullRefreshCommand}"
                     IsRefreshing="{Binding EstaRefrescando}"
                     RefreshColor="{toolkit:AppThemeResource Icon}"
                     Background="{toolkit:AppThemeResource Background}">
        <CollectionView ItemsSource="{Binding Usuarios}"
                        Margin="0,4">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EquipoUsuarioItem">
                    <SwipeView Margin="16,6">
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                                <SwipeItemView Command="{Binding DeleteCommand}">
                                    <Border BackgroundColor="{toolkit:AppThemeResource Error}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            Padding="5"
                                            WidthRequest="{Binding SwipeItemWidth}">
                                        <Image WidthRequest="26"
                                               HeightRequest="26"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center"
                                               mi:MauiIcon.Value="{mi:Material Icon=Delete}" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                                <SwipeItemView Command="{Binding ConfigurarCommand}">
                                    <Border BackgroundColor="{toolkit:AppThemeResource Primary}"
                                            IsVisible="{Binding MostrarConfigurar}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            Padding="5"
                                            WidthRequest="{Binding SwipeItemWidth}">
                                        <Image WidthRequest="26"
                                               HeightRequest="26"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               mi:MauiIcon.Value="{mi:Material Icon=Settings}" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>

                    <Border Margin="0"
                            Padding="10,5"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}">
                            <Border.Shadow>
                                <Shadow Brush="Black" Radius="14" Opacity="0.11" Offset="0,5" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="5,*">

                                <!-- Barra de acento izquierda según estado -->
                        <BoxView Grid.Column="0"
                             BackgroundColor="{toolkit:AppThemeResource Primary}"
                             WidthRequest="4" CornerRadius="2"
                             VerticalOptions="Fill" />

                                <!-- Contenido de la card -->
                                <Grid Grid.Column="1"
                                      Padding="5"   
                                      ColumnDefinitions="56,*"
                                      ColumnSpacing="14">

                                    <!-- Avatar con iniciales -->
                                    <Border Grid.Column="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            StrokeShape="RoundRectangle 24"
                                            StrokeThickness="0"
                                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Iniciales}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Datos del usuario -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Email}"
                                               IsVisible="{Binding TieneEmail}"
                                               FontSize="12"
                                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TipoCuentaTexto}"
                                               FontSize="12"
                                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Grid>
                    </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <!-- Spinner de carga centrado -->
        <ActivityIndicator IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           Color="{toolkit:AppThemeResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- FAB expandible -->
        <VerticalStackLayout
                             HorizontalOptions="End"
                             VerticalOptions="End"
                             Margin="0,0,16,16"
                             Spacing="12">

            <!-- Sub-botones (visibles al expandir) -->
            <VerticalStackLayout x:Name="SubBotonesPanel"
                                 IsVisible="False"
                                 Opacity="0"
                                 Spacing="12"
                                 HorizontalOptions="End">

                <!-- Sin cuenta -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarSinCuentaCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border WidthRequest="80" HeightRequest="65"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HorizontalOptions="Center"
                            Padding="5">
                        <Border.Shadow>
                            <Shadow Brush="Black" Radius="6" Opacity="0.15" Offset="0,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                            <mi:MauiIcon Icon="{mi:Material Icon=PersonAddAlt}"
                                     IconSize="28"
                                     IconColor="{toolkit:AppThemeResource Icon}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                            <Label Text="Sin cuenta"
                           FontSize="11"
                           TextColor="{toolkit:AppThemeResource Icon}"
                           HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Con Cuenta -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarConCuentaCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border WidthRequest="80" HeightRequest="65"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            HorizontalOptions="Center"
                            Padding="5">
                        <Border.Shadow>
                            <Shadow Brush="Black" Radius="6" Opacity="0.15" Offset="0,3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=PersonAdd}"
                                     IconSize="28"
                                     IconColor="{toolkit:AppThemeResource Icon}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                            <Label Text="Con Cuenta"
                           FontSize="11"
                           TextColor="{toolkit:AppThemeResource Icon}"
                           HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Botón FAB principal -->
            <Border WidthRequest="50" HeightRequest="50"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    HorizontalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="Black" Radius="10" Opacity="0.22" Offset="0,4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFabCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                    <mi:MauiIcon Icon="{mi:Material Icon=Add}"
                                 IconSize="20"
                                 IconColor="{toolkit:AppThemeResource Icon}"
                                 IsVisible="{Binding FabColapsado}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                    <mi:MauiIcon Icon="{mi:Material Icon=KeyboardArrowDown}"
                                 IconSize="20"
                                 IconColor="{toolkit:AppThemeResource Icon}"
                                 IsVisible="{Binding FabExpandido}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>

        </Grid><!-- /Grid.Row=1 wrapper -->

    </Grid>

</ContentPage>
