<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             xmlns:f="clr-namespace:Fonts"
             x:Class="ContaBeeMovil.Pages.Comprobaciones.DetalleComprobacionPage"
             Title="Detalle"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="OnEditarClicked" Order="Primary" Priority="0">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FluentUI"
                                 Glyph="{x:Static f:FluentUI.edit_20_regular}"
                                 Color="{toolkit:AppThemeResource PrimaryText}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Clicked="OnEliminarClicked" Order="Primary" Priority="1">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FluentUI"
                                 Glyph="{x:Static f:FluentUI.delete_20_regular}"
                                 Color="{toolkit:AppThemeResource PrimaryText}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="8">
                <Border Style="{StaticResource ElevatedCard}" Padding="10,8">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Creación" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding CreacionTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Vence" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding CierreTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Text="RFC:" Style="{StaticResource Body2Strong}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Rfc}"
                                   Style="{StaticResource Body2}"
                                   LineBreakMode="TailTruncation" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Requerido" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding RequeridoTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Depositado" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding MontoTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Comprobado (%)" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding ComprobadoPorcentajeTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Comprobado ($)" Style="{StaticResource Caption1}" />
                                <Label Text="{Binding MontoComprobadoTexto}" Style="{StaticResource Body2Strong}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Motivo" Style="{StaticResource Caption1}" />
                            <Label Text="{Binding DescripcionTexto}" Style="{StaticResource Body2}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Grid IsVisible="{Binding PuedeActualizarEstado}"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Margin="0,4,0,0">
                            <views:SelectorFlotante Grid.Column="0"
                                                    Titulo="Estado"
                                                    Elementos="{Binding EstadosDisponibles}"
                                                    ElementoSeleccionado="{Binding EstadoSeleccionado}" />
                            <Button Grid.Column="1"
                                    Text="Actualizar"
                                    Command="{Binding ActualizarEstadoCommand}"
                                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                                    TextColor="{toolkit:AppThemeResource PrimaryText}"
                                    CornerRadius="10"
                                    HeightRequest="44" />
                        </Grid>

                        <VerticalStackLayout Spacing="6"
                                             Margin="0,8,0,0">
                            <Label Text="Capturas"
                                   Style="{StaticResource Caption1}" />
                            <Label Text="Sin Resultados"
                                   Style="{StaticResource Body2Strong}"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding TieneCapturasRelacionadas, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Text="¡Vaya! Parece que no hay nada aquí"
                                   Style="{StaticResource Body2}"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding TieneCapturasRelacionadas, Converter={StaticResource InvertedBoolConverter}}" />

                            <VerticalStackLayout IsVisible="{Binding TieneCapturasRelacionadas}"
                                                 Spacing="4"
                                                 BindableLayout.ItemsSource="{Binding CapturasRelacionadas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <views:LoteCapturaCardView />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border WidthRequest="44"
                HeightRequest="44"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0"
                Padding="0"
                BackgroundColor="{toolkit:AppThemeResource Primary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,8,8">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding IrCapturaCommand}" />
            </Border.GestureRecognizers>
            <Label Text="{x:Static f:FluentUI.camera_20_regular}"
                   FontFamily="FluentUI"
                   FontSize="20"
                   TextColor="#1A1A1A"
                   WidthRequest="44"
                   HeightRequest="44"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />
        </Border>

        <Grid IsVisible="{Binding EstaCargando}"
              BackgroundColor="#66000000"
              InputTransparent="False"
              ZIndex="20">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
