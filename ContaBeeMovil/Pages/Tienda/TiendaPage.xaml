<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:ContaBeeMovil.Pages.Tienda"
             x:Class="ContaBeeMovil.Pages.Tienda.TiendaPage"
             Title="Tienda"
             BackgroundColor="{toolkit:AppThemeResource Background}"
             Shell.BackgroundColor="{toolkit:AppThemeResource AppBarPrimary}"
             Shell.TitleColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.ForegroundColor="{toolkit:AppThemeResource PrimaryText}"
             Shell.TabBarIsVisible="False">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="2,2,15,0">
            <Label Grid.Column="0"
                   Text="Tienda"
                   Style="{StaticResource Body1Strong}"
                   FontSize="15"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="Resumen"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    BorderWidth="1"
                    TextColor="{toolkit:AppThemeResource PrimaryText}"
                    CornerRadius="10"
                    Padding="10,2"
                    FontSize="12"
                    VerticalOptions="Center"
                    Clicked="OnVerDetalleLicenciaClicked" />
        </Grid>
    </Shell.TitleView>

    <Grid>

        <CollectionView x:Name="ListaProductos"
                        SelectionMode="None"
                        Margin="10,10">

            <CollectionView.Header>
                <VerticalStackLayout x:Name="DebugCompraDirecta"
                                     Padding="0,0,0,8"
                                     Spacing="6"
                                     IsVisible="False">
                    <Label Text="[DEV] Compra directa"
                           Style="{StaticResource Caption1}"
                           TextColor="{toolkit:AppThemeResource SecondaryText}"
                           HorizontalOptions="Center"/>
                    <Button Text="Comprar captura15 directo"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            TextColor="#1a1a1a"
                            CornerRadius="12"
                            Padding="16,12"
                            HorizontalOptions="Fill"
                            Clicked="OnCompraDirectaClicked"/>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ProductoIAPModel">
                    <Border Style="{StaticResource ElevatedCard}" Padding="10">
                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{toolkit:AppThemeResource Primary}"
                                     WidthRequest="4" CornerRadius="2"
                                     VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}"
                                       Style="{StaticResource Body1}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding PrecioTexto}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource Primary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Comprar"
                                    IsEnabled="{Binding DisponibleEnTienda}"
                                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                                    TextColor="#1a1a1a"
                                    CornerRadius="12"
                                    Padding="16,8"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnComprarClicked"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Overlay de carga — al final para quedar encima del contenido -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="True"
              BackgroundColor="Transparent"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="{toolkit:AppThemeResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
