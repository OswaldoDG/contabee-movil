<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:views="clr-namespace:ContaBeeMovil.Views"
             x:Class="ContaBeeMovil.Views.FiltrosDevolucionesView">

    <Border Style="{StaticResource FiltersStyle}" Padding="8">
        <VerticalStackLayout Spacing="8">

            <VerticalStackLayout x:Name="PanelFiltros" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <views:SelectorFlotante x:Name="SelectorAnio"
                                            Grid.Column="0"
                                            Titulo="Año" />
                    <views:SelectorFlotante x:Name="SelectorMes"
                                            Grid.Column="1"
                                            Titulo="Mes" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <views:SelectorFlotante x:Name="SelectorEstado"
                                            Grid.Column="0"
                                            Titulo="Estado" />
                    <views:SelectorFlotante x:Name="SelectorDestinatario"
                                            Grid.Column="1"
                                            Titulo="Destinatario" />
                </Grid>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">

                <views:SelectorFlotante x:Name="SelectorOrden"
                                        Grid.Column="0"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center" />

                <Border Grid.Column="1"
                        Style="{StaticResource CircleIconButton}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleOrden" />
                    </Border.GestureRecognizers>
                    <Label x:Name="IconOrden"
                           Style="{StaticResource CircleIconLabel}"
                           Text="{x:Static f:FluentUI.arrow_sort_down_lines_20_regular}" />
                </Border>

                <Border x:Name="BtnBuscar"
                        Grid.Column="2"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBuscarTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static f:FluentUI.search_20_regular}"
                           FontFamily="{x:Static f:FluentUI.FontFamily}"
                           FontSize="20"
                           TextColor="#1A1A1A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource CircleIconButton}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleExpandir" />
                    </Border.GestureRecognizers>
                    <Label x:Name="IconExpandir"
                           Style="{StaticResource CircleIconLabel}"
                           Text="{x:Static f:FluentUI.chevron_up_20_regular}" />
                </Border>
            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
