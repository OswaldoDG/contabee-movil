<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ContaBeeMovil.Views.ActualizarComprobacionPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="CardBorder"
            BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 16"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="16"
            MinimumWidthRequest="280"
            MaximumWidthRequest="560">
        <Border.Shadow>
            <Shadow Brush="#5e000000"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.4" />
        </Border.Shadow>

        <ScrollView x:Name="PopupScroll"
                    HorizontalScrollBarVisibility="Never">
            <Grid WidthRequest="{Binding Source={x:Reference PopupScroll}, Path=Width}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Editar"
                           FontAttributes="Bold"
                           FontSize="24"
                           HorizontalOptions="Center"
                           TextColor="{toolkit:AppThemeResource PrimaryText}" />

                    <BoxView HeightRequest="1" Color="{toolkit:AppThemeResource Accent1}" Opacity="0.35" />

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="4">
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Creación"
                               FontSize="14"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               x:Name="LblCreacion"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               Margin="0,6,0,0" />

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="Vence"
                               FontSize="14"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        <DatePicker Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="PickerCierre"
                                    Format="dd/MM/yyyy"
                                    MinimumDate="2000-01-01"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill"
                                    FontSize="17"
                                    BackgroundColor="Transparent"
                                    TextColor="{toolkit:AppThemeResource PrimaryText}" />
                    </Grid>

                    <Label x:Name="LblRfc"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />

                    <Grid ColumnDefinitions="Auto,24,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8"
                          RowSpacing="10">
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Depositado:"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="$"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />
                        <Border Grid.Row="0"
                                Grid.Column="2"
                                BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,4"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                            <Entry x:Name="EntryMonto"
                                   Keyboard="Numeric"
                                   Placeholder="0.00"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="End"
                                   FlowDirection="LeftToRight"
                                   VerticalTextAlignment="Center"
                                   HeightRequest="32"
                                   FontSize="16"
                                   Margin="0"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />
                        </Border>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Comprobado:"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="$"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,4"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                            <Label x:Name="LblComprobado"
                                   FontSize="16"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                    HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="End"
                                   VerticalTextAlignment="Center"
                                   Margin="0"
                                   HeightRequest="32" />
                        </Border>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="Requerido:"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalTextAlignment="Center" />
                        <Label Grid.Row="2"
                               Grid.Column="1"
                               Text="%"
                               FontSize="16"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center" />
                        <Border Grid.Row="2"
                                Grid.Column="2"
                                BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,4"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                            <Entry x:Name="EntryPorcentaje"
                                   Keyboard="Numeric"
                                   Placeholder="0-100"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="End"
                                   FlowDirection="LeftToRight"
                                   VerticalTextAlignment="Center"
                                   HeightRequest="32"
                                   FontSize="16"
                                   Margin="0"
                                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                                   PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="ISR"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Editor x:Name="EntryDescripcion"
                                    Placeholder="Escribe el motivo"
                                    AutoSize="TextChanges"
                                    HeightRequest="56"
                                    FontSize="16"
                                    TextColor="{toolkit:AppThemeResource PrimaryText}"
                                    PlaceholderColor="{toolkit:AppThemeResource SecondaryText}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Cancelar"
                                BackgroundColor="Transparent"
                                BorderColor="{toolkit:AppThemeResource Accent1}"
                                BorderWidth="1"
                                TextColor="{toolkit:AppThemeResource PrimaryText}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46"
                                Clicked="OnCancelar" />

                        <Button Grid.Column="1"
                                Text="Guardar"
                                BackgroundColor="{toolkit:AppThemeResource Primary}"
                                TextColor="{toolkit:AppThemeResource PrimaryText}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46"
                                Clicked="OnGuardar" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Border>

</toolkit:Popup>
