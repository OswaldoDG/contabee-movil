<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
               x:Class="ContaBeeMovil.Views.CrearCapturistaPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="CardBorder"
            BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Fill"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 10"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="20">
        <Border.Shadow>
            <Shadow Brush="#5e000000" Offset="0,4" Radius="16" Opacity="0.4" />
        </Border.Shadow>


        <VerticalStackLayout Spacing="12">

            <Label Text="Usuario de Captura"
                       FontAttributes="Bold"
                       FontSize="20"
                       HorizontalOptions="Center"
                       TextColor="{toolkit:AppThemeResource PrimaryText}" />
            <BoxView Style="{StaticResource Divider}" />

            <!-- Nombre -->
            <Border StrokeShape="RoundRectangle 10"
                        Stroke="Transparent"
                        BackgroundColor="{toolkit:AppThemeResource Alternate}"
                        Padding="12,8">
                <Entry x:Name="EntryNombre"
                           Placeholder="Nombre"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           FontSize="15"
                           TextChanged="OnNombreChanged" />
            </Border>

            <!-- Teléfono -->
            <Border StrokeShape="RoundRectangle 10"
                        Stroke="Transparent"
                        BackgroundColor="{toolkit:AppThemeResource Alternate}"
                        Padding="12,8">
                <Entry x:Name="EntryTelefono"
                           Placeholder="Teléfono Opcional"
                           Keyboard="Telephone"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           FontSize="15" />
            </Border>

            <!-- Contraseña -->
            <Border StrokeShape="RoundRectangle 10"
                        Stroke="Transparent"
                        BackgroundColor="{toolkit:AppThemeResource Alternate}"
                        Padding="0">
                <Grid ColumnDefinitions="*,Auto" Padding="12,10">
                    <Entry x:Name="EntryPassword"
                               Grid.Column="0"
                               Placeholder="Contraseña"
                               IsPassword="True"
                               Keyboard="Plain"
                               BackgroundColor="Transparent"
                               PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="15"
                               TextChanged="OnPasswordChanged" />
                    <mi:MauiIcon x:Name="ToggleContrasenas"
                                 Grid.Column="1"
                                 Icon="{mi:Material Icon=Visibility}"
                                 IconColor="{toolkit:AppThemeResource Icon}"
                                 IconSize="25"
                                 VerticalOptions="Center"
                                 BackgroundColor="Transparent">
                        <mi:MauiIcon.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleContrasenasClicked" />
                        </mi:MauiIcon.GestureRecognizers>
                    </mi:MauiIcon>
                </Grid>
            </Border>

            <!-- Confirmar Contraseña -->
            <Border StrokeShape="RoundRectangle 10"
                        Stroke="Transparent"
                        BackgroundColor="{toolkit:AppThemeResource Alternate}"
                        Padding="0">
                <Grid ColumnDefinitions="*,Auto" Padding="12,10">
                    <Entry x:Name="EntryConfirm"
                               Grid.Column="0"
                               Placeholder="Confirmar Contraseña"
                               IsPassword="True"
                               Keyboard="Plain"
                               BackgroundColor="Transparent"
                               PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="15"
                               TextChanged="OnPasswordChanged" />
                </Grid>
            </Border>

            <!-- Error contraseñas no coinciden -->
            <Label x:Name="LblError"
                       TextColor="{toolkit:AppThemeResource Error}"
                       FontSize="12"
                       Margin="4,0,0,0"
                       IsVisible="False" />

            <!-- Validaciones de contraseña -->
            <VerticalStackLayout Spacing="5" Margin="12,5,0,0">
                <Label Text="Tu contraseña debe contener:"
                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,0,0,2" />
                <VerticalStackLayout Spacing="5" Margin="12,0,0,0">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <mi:MauiIcon x:Name="IconMin6"
                                     Icon="{mi:Material Icon=Check}"
                                     IconColor="{toolkit:AppThemeResource Disabled}"
                                     IconSize="20"
                                     WidthRequest="20" HeightRequest="20" />
                        <Label Text="Mínimo 6 caracteres"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="14" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <mi:MauiIcon x:Name="IconMayus"
                                     Icon="{mi:Material Icon=Check}"
                                     IconColor="{toolkit:AppThemeResource Disabled}"
                                     IconSize="20"
                                     WidthRequest="20" HeightRequest="20" />
                        <Label Text="Una letra mayúscula"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="14" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <mi:MauiIcon x:Name="IconNumero"
                                     Icon="{mi:Material Icon=Check}"
                                     IconColor="{toolkit:AppThemeResource Disabled}"
                                     IconSize="20"
                                     WidthRequest="18" HeightRequest="18" />
                        <Label Text="Un número"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="14" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <mi:MauiIcon x:Name="IconEspecial"
                                     Icon="{mi:Material Icon=Check}"
                                     IconColor="{toolkit:AppThemeResource Disabled}"
                                     IconSize="20"
                                     WidthRequest="18" HeightRequest="18" />
                        <Label Text="Caracter especial (@ # $ %)"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Botones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                <Button Text="Cancelar"
                            BackgroundColor="Transparent"
                            BorderColor="{toolkit:AppThemeResource Accent1}"
                            BorderWidth="1"
                            TextColor="{toolkit:AppThemeResource PrimaryText}"
                            CornerRadius="10"
                            HeightRequest="44"
                            Clicked="OnCancelar" />
                <Button x:Name="BtnCrear"
                            Grid.Column="1"
                            Text="Crear"
                            BackgroundColor="{toolkit:AppThemeResource Disabled}"
                            TextColor="{toolkit:AppThemeResource SecondaryText}"
                            CornerRadius="10"
                            HeightRequest="44"
                            IsEnabled="False"
                            Clicked="OnCrear">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                            <Setter Property="TextColor"       Value="{toolkit:AppThemeResource SecondaryText}" />
                            <Setter Property="Opacity"         Value="1" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>