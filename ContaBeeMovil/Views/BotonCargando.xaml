<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ContaBeeMovil.Views.BotonCargando">

    <Grid>
        <Button x:Name="BotonInterno"
                BackgroundColor="{toolkit:AppThemeResource Primary}"
                TextColor="{toolkit:AppThemeResource PrimaryText}"
                Clicked="BotonInterno_Clicked" />

        <ActivityIndicator x:Name="Spinner"
                           Color="{toolkit:AppThemeResource PrimaryText}"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True"
                           IsVisible="False"
                           IsRunning="False" />
    </Grid>
</ContentView>
