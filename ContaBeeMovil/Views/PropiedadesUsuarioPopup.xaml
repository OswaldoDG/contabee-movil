<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ContaBeeMovil.Views.PropiedadesUsuarioPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="CardBorder"
            BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 10"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="20">
        <Border.Shadow>
            <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,4" Radius="16" Opacity="0.4" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

            <!-- Encabezado -->
            <VerticalStackLayout Grid.Row="0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" HorizontalOptions="Fill">
                    <HorizontalStackLayout Grid.Column="0"
                                          HorizontalOptions="Center"
                                          Spacing="8">
                        <Label x:Name="LblTitulo"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               VerticalOptions="Center" />
                        <Border x:Name="BadgeYo"
                                IsVisible="False"
                                BackgroundColor="{toolkit:AppThemeResource Primary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                Padding="6,2"
                                VerticalOptions="Center">
                            <Label Text="Yo"
                                   FontSize="10"
                                   TextColor="{toolkit:AppThemeResource OnPrimary}"
                                   FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                    <Switch x:Name="SwitchActiva"
                            Grid.Column="1"
                            OnColor="{toolkit:AppThemeResource Primary}"
                            Scale="0.9"
                            VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource Divider}" />
            </VerticalStackLayout>

            <!-- Contenido: formulario + spinner de carga -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <VerticalStackLayout x:Name="FormContent" Spacing="8">
                    <Label Text="Propiedades"
                           FontSize="14"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />

                    <!-- Toggle: UsuarioCaptura -->
                    <Grid x:Name="FilaCaptura" ColumnDefinitions="*,Auto">
                        <Label Text="Puede Capturar"
                               VerticalOptions="Center"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Switch x:Name="SwitchCaptura"
                                Grid.Column="1"
                                OnColor="{toolkit:AppThemeResource Primary}"
                                Scale="1.3"
                                Margin="0,0,8,0" />
                    </Grid>

                    <!-- Panel debug (solo modo dev) -->
                    <Border x:Name="PanelDebug"
                            IsVisible="False"
                            BackgroundColor="#1A1A1A"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#00FF99"
                            Margin="0,8,0,0">
                        <Label x:Name="LblDebugInfo"
                               TextColor="#00FF99"
                               FontSize="11"
                               FontFamily="Courier New"
                               LineBreakMode="WordWrap"
                               Padding="10,8" />
                    </Border>

                </VerticalStackLayout>

                <!-- Spinner overlay mientras carga o guarda -->
                <VerticalStackLayout x:Name="SpinnerPanel"
                                     IsVisible="False"
                                     Spacing="10"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator x:Name="Spinner"
                                       IsRunning="False"
                                       HorizontalOptions="Center"
                                       Color="{toolkit:AppThemeResource Primary}" />
                    <Label x:Name="LblSpinner"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           FontSize="13"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Botones -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cerrar"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnCancelar" />
                <Button x:Name="BtnGuardar"
                        Grid.Column="1"
                        Text="Guardar"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                        CornerRadius="12"
                        HeightRequest="48"
                        IsEnabled="False"
                        Clicked="OnGuardar">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                            <Setter Property="TextColor"       Value="{toolkit:AppThemeResource SecondaryText}" />
                            <Setter Property="Opacity"         Value="1" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>

        </Grid>
    </Border>

</toolkit:Popup>
