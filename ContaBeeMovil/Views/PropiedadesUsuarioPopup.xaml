<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ContaBeeMovil.Views.PropiedadesUsuarioPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <!-- Todos los cambios se aplican al instante (patrón de pantalla de ajustes):
         no hay botón Guardar ni estado sucio; cada fila guarda al vuelo con su
         propio indicador y revierte el switch si el backend falla. -->
    <Border x:Name="CardBorder"
            BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 10"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="20">
        <Border.Shadow>
            <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,4" Radius="16" Opacity="0.4" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="0">

            <!-- Encabezado -->
            <VerticalStackLayout Grid.Row="0" Spacing="8">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label x:Name="LblTitulo"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{toolkit:AppThemeResource PrimaryText}"
                           VerticalOptions="Center" />
                    <Border x:Name="BadgeYo"
                            IsVisible="False"
                            BackgroundColor="{toolkit:AppThemeResource Primary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 4"
                            Padding="6,2"
                            VerticalOptions="Center">
                        <Label Text="Yo"
                               FontSize="10"
                               TextColor="{toolkit:AppThemeResource OnPrimary}"
                               FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>
                <BoxView Style="{StaticResource Divider}" />
            </VerticalStackLayout>

            <!-- Contenido: formulario + spinner de carga inicial -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <VerticalStackLayout x:Name="FormContent" Spacing="8">
                    <Label Text="Propiedades"
                           FontSize="14"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />

                    <!-- Toggle: asociación activa. Afecta SOLO la pertenencia a ESTA
                         cuenta fiscal; la cuenta propia del otro usuario sigue intacta,
                         por eso se habla de "colaborador" y nunca de desactivar su cuenta. -->
                    <Grid x:Name="FilaActiva" ColumnDefinitions="*,20,Auto" ColumnSpacing="6">
                        <!-- El texto lo fija ActualizarEtiquetaActiva(): Activo / Inactivo -->
                        <Label x:Name="LblActiva"
                               Text="Activo"
                               VerticalOptions="Center"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <!-- Opacity (no IsVisible) para que la fila no salte al aparecer -->
                        <ActivityIndicator x:Name="SpinnerActiva"
                                           Grid.Column="1"
                                           IsRunning="False"
                                           Opacity="0"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           VerticalOptions="Center"
                                           Color="{toolkit:AppThemeResource Primary}" />
                        <Switch x:Name="SwitchActiva"
                                Grid.Column="2"
                                OnColor="{toolkit:AppThemeResource Primary}"
                                Margin="0,0,8,0" />
                    </Grid>

                    <!-- Toggle: UsuarioCaptura -->
                    <Grid x:Name="FilaCaptura" ColumnDefinitions="*,20,Auto" ColumnSpacing="6">
                        <Label Text="Puede Capturar"
                               VerticalOptions="Center"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <ActivityIndicator x:Name="SpinnerCaptura"
                                           Grid.Column="1"
                                           IsRunning="False"
                                           Opacity="0"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           VerticalOptions="Center"
                                           Color="{toolkit:AppThemeResource Primary}" />
                        <Switch x:Name="SwitchCaptura"
                                Grid.Column="2"
                                OnColor="{toolkit:AppThemeResource Primary}"
                                Margin="0,0,8,0" />
                    </Grid>

                    <!-- Explica por qué la fila de captura está bloqueada -->
                    <Label x:Name="LblAyudaCaptura"
                           IsVisible="False"
                           Text="Un colaborador inactivo no puede capturar."
                           FontSize="12"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />

                    <!-- Panel debug (solo modo dev) -->
                    <Border x:Name="PanelDebug"
                            IsVisible="False"
                            BackgroundColor="#1A1A1A"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#00FF99"
                            Margin="0,8,0,0">
                        <Label x:Name="LblDebugInfo"
                               TextColor="#00FF99"
                               FontSize="11"
                               FontFamily="Courier New"
                               LineBreakMode="WordWrap"
                               Padding="10,8" />
                    </Border>

                </VerticalStackLayout>

                <!-- Spinner de la carga inicial (el formulario aún no tiene datos) -->
                <VerticalStackLayout x:Name="SpinnerPanel"
                                     IsVisible="False"
                                     Spacing="10"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator x:Name="Spinner"
                                       IsRunning="False"
                                       HorizontalOptions="Center"
                                       Color="{toolkit:AppThemeResource Primary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Botón -->
            <Button Grid.Row="2"
                    Text="Cerrar"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnCerrar" />

        </Grid>
    </Border>

</toolkit:Popup>
