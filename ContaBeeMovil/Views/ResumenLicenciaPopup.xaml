<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ContaBeeMovil.Views.ResumenLicenciaPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 10"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="10"
            MinimumWidthRequest="360">
        <Border.Shadow>
            <Shadow Brush="{toolkit:AppThemeResource Shadow}"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="14">

            <!-- Título -->
            <Label Text="Mis Créditos"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource PrimaryText}" />
            <BoxView Style="{StaticResource Divider}" />

            <!-- RFC -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="RFC:"
                       Style="{StaticResource Caption1}"
                       TextColor="{toolkit:AppThemeResource SecondaryText}"
                       VerticalOptions="Center"/>
                <Label x:Name="LblRfc"
                       Grid.Column="1"
                       Text="—"
                       Style="{StaticResource Body1}"
                       FontAttributes="Bold"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       VerticalOptions="Center"/>
            </Grid>

            <BoxView Style="{StaticResource Divider}" />

            <!-- Los tres tipos de créditos -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                <!-- Captura -->
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Captura"
                           Style="{StaticResource Caption1}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    <Border BackgroundColor="{toolkit:AppThemeResource Background}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            StrokeThickness="1"
                            Padding="8,10"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="LblCreditosCaptura"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource Captura}" />
                            <Label Text="disponibles"
                                   Style="{StaticResource Caption1}"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Colaboración -->
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Colaboración"
                           Style="{StaticResource Caption1}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    <Border BackgroundColor="{toolkit:AppThemeResource Background}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            StrokeThickness="1"
                            Padding="8,10"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="LblCreditosColab"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource Colab}" />
                            <Label Text="disponibles"
                                   Style="{StaticResource Caption1}"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Autoservicio -->
                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label Text="Autoservicio"
                           Style="{StaticResource Caption1}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{toolkit:AppThemeResource SecondaryText}" />
                    <Border BackgroundColor="{toolkit:AppThemeResource Background}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{toolkit:AppThemeResource Accent1}"
                            StrokeThickness="1"
                            Padding="8,10"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="LblCreditosAuto"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource Auto}" />
                            <Label Text="disponibles"
                                   Style="{StaticResource Caption1}"
                                   HorizontalOptions="Center"
                                   TextColor="{toolkit:AppThemeResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>

            <!-- Botón cerrar -->
            <Button Text="Cerrar"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnCerrar" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
