<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:f="clr-namespace:Fonts"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:vm="clr-namespace:ContaBeeMovil.Pages.Dashboard"
             x:Class="ContaBeeMovil.Views.ActividadView"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{toolkit:AppThemeResource Background}">

    <Grid Margin="8,1,8,8"
          Padding="5,1,5,0">

        <RefreshView x:Name="PullRefresh"
                     Command="{Binding PullRefreshCommand}"
                     IsRefreshing="{Binding EstaRefrescando}"
                     RefreshColor="{toolkit:AppThemeResource Icon}"
                     IsVisible="{Binding MostrarContenido}"
                     Background="{toolkit:AppThemeResource Background}">
          <ScrollView x:Name="MainScroll" VerticalScrollBarVisibility="Never">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  RowSpacing="10"
                  Padding="0,5,0,0"
                  HeightRequest="{Binding Source={x:Reference MainScroll}, Path=Height}">

                <Border Grid.Row="0"
                        IsVisible="{Binding SinActividad}"
                        BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,6">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="{x:Static f:FluentUI.info_20_regular}" FontFamily="FluentUI"
                                     TextColor="{toolkit:AppThemeResource SecondaryText}"
                                     FontSize="18"
                                     VerticalOptions="Center" />
                        <Label Text="Aún no tienes actividad registrada"
                               FontSize="13"
                               TextColor="{toolkit:AppThemeResource SecondaryText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Créditos de licenciamiento — tap para ciclar visibilidad -->
                <Grid Grid.Row="1"
                      ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ColAuto" Width="*" />
                        <ColumnDefinition x:Name="ColColab" Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreditosTapped" />
                    </Grid.GestureRecognizers>
                    -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Border x:Name="BorderCaptura"
                                BackgroundColor="{toolkit:AppThemeResource CardBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="0"
                                HorizontalOptions="Fill">
                            <Grid RowDefinitions="4,*">
                                <BoxView Grid.Row="0" Color="{toolkit:AppThemeResource Captura}" />
                                <Label x:Name="LabelCaptura" Grid.Row="1"
                                       Text="{Binding CreditosCapturaDisponibles}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       Padding="0,8"
                                       HorizontalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Captura"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Badge "+N" de la animación de compra (box de Captura) -->
                    <Label x:Name="BadgeCaptura" Grid.Column="0" Text="+21" IsVisible="False"
                           InputTransparent="True" FontSize="24" FontAttributes="Bold"
                           TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Start"
                           ZIndex="10" />

                    <VerticalStackLayout x:Name="VStackColab" Grid.Column="2" Spacing="4">
                        <Border x:Name="BorderColab"
                                BackgroundColor="{toolkit:AppThemeResource CardBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="0"
                                HorizontalOptions="Fill">
                            <Grid RowDefinitions="4,*">
                                <BoxView Grid.Row="0" Color="{toolkit:AppThemeResource Colab}" />
                                <Label x:Name="LabelColab" Grid.Row="1"
                                       Text="{Binding CreditosColabDisponibles}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       Padding="0,8"
                                       HorizontalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Colaboración"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Badge "+N" de la animación de compra (box de Colaboración) -->
                    <Label x:Name="BadgeColab" Grid.Column="2" Text="+21" IsVisible="False"
                           InputTransparent="True" FontSize="24" FontAttributes="Bold"
                           TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Start"
                           ZIndex="10" />

                    <VerticalStackLayout x:Name="VStackAuto" Grid.Column="1" Spacing="4">
                        <Border x:Name="BorderAuto"
                                BackgroundColor="{toolkit:AppThemeResource CardBackground}"
                                Stroke="{toolkit:AppThemeResource Accent1}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="0"
                                HorizontalOptions="Fill">
                            <Grid RowDefinitions="4,*">
                                <BoxView Grid.Row="0" Color="{toolkit:AppThemeResource Auto}" />
                                <Label x:Name="LabelAuto" Grid.Row="1"
                                       Text="{Binding CreditosAutoDisponibles}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                                       Padding="0,8"
                                       HorizontalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Autoservicio"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Badge "+N" de la animación de compra (box de Autoservicio) -->
                    <Label x:Name="BadgeAuto" Grid.Column="1" Text="+21" IsVisible="False"
                           InputTransparent="True" FontSize="24" FontAttributes="Bold"
                           TextColor="#16A34A" HorizontalOptions="Center" VerticalOptions="Start"
                           ZIndex="10" />

                </Grid>

                <Border Grid.Row="2"
                        BackgroundColor="{toolkit:AppThemeResource Primary}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        Padding="16,6">
                    <Label HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="$ "
                                      FontSize="26"
                                      FontAttributes="Bold"
                                      TextColor="{toolkit:AppThemeResource OnPrimary}" />
                                <Span Text="{Binding TotalFacturado, StringFormat='{0:N2}'}"
                                      FontSize="26"
                                      FontAttributes="Bold"
                                      TextColor="{toolkit:AppThemeResource OnPrimary}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="5">

                    <!--
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Border BackgroundColor="{toolkit:AppThemeResource Primary}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="1,10"
                                HorizontalOptions="Fill">
                            <Label Text="{Binding CreditosRestantes}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{toolkit:AppThemeResource OnPrimary}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Restantes"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    -->

                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Border BackgroundColor="{toolkit:AppThemeResource DarkSurface}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,10"
                                HorizontalOptions="Fill">
                            <Label Text="{Binding Emitidas}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Emitidas"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Border BackgroundColor="{toolkit:AppThemeResource DarkSurface}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,10"
                                HorizontalOptions="Fill">
                            <Label Text="{Binding Declinadas}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Fallidas"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Border BackgroundColor="{toolkit:AppThemeResource DarkSurface}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,10"
                                HorizontalOptions="Fill">
                            <Label Text="{Binding Pendientes}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Pendientes"
                               FontSize="11"
                               TextColor="{toolkit:AppThemeResource StatLabel}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </Grid>

                <Border Grid.Row="4"
                        IsVisible="{Binding SinActividad, Converter={toolkit:InvertedBoolConverter}}"
                        BackgroundColor="{toolkit:AppThemeResource Background}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        Margin="0,3,0,3">
                    <Grid RowDefinitions="Auto,Auto,*">

                        <Label Grid.Row="0"
                               HorizontalOptions="Center"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{toolkit:AppThemeResource PrimaryText}"
                               Margin="0,0,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Actividad " />
                                    <Span Text="{Binding MesNombreTexto}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <HorizontalStackLayout Grid.Row="1"
                                               HorizontalOptions="Center"
                                               Spacing="16"
                                               Margin="0,4">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse Fill="#FFC107" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                                <Label Text="Emitidos" FontSize="11" VerticalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Ellipse Fill="#E65100" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                                <Label Text="Solicitados" FontSize="11" VerticalOptions="Center"
                                       TextColor="{toolkit:AppThemeResource SecondaryText}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <chart:SfCartesianChart Grid.Row="2"
                                                Margin="8,0,8,8"
                                                BackgroundColor="Transparent">
                            <chart:SfCartesianChart.XAxes>
                                <chart:NumericalAxis Minimum="1"
                                                     Maximum="{Binding MaximoEjeX}"
                                                     Interval="5"
                                                     ShowMajorGridLines="False"
                                                     EdgeLabelsDrawingMode="Center">
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle FontSize="10" />
                                    </chart:NumericalAxis.LabelStyle>
                                </chart:NumericalAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis Minimum="0"
                                                     Maximum="{Binding MaximoEjeY}"
                                                     Interval="1"
                                                     ShowMajorGridLines="True">
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle FontSize="10" LabelFormat="0" />
                                    </chart:NumericalAxis.LabelStyle>
                                </chart:NumericalAxis>
                            </chart:SfCartesianChart.YAxes>

                            <chart:ColumnSeries ItemsSource="{Binding DatosGrafica}"
                                                XBindingPath="Dia"
                                                YBindingPath="Emitidas"
                                                Fill="#FFC107"
                                                Width="0.4"
                                                Spacing="0.1" />

                            <chart:ColumnSeries ItemsSource="{Binding DatosGrafica}"
                                                XBindingPath="Dia"
                                                YBindingPath="Solicitadas"
                                                Fill="#E65100"
                                                Width="0.4"
                                                Spacing="0.1" />
                        </chart:SfCartesianChart>

                    </Grid>
                </Border>

            </Grid>
          </ScrollView>
        </RefreshView>

        <!-- Panel de error (overlay) -->
        <VerticalStackLayout IsVisible="{Binding MostrarError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <Label Text="{x:Static f:FluentUI.cloud_off_20_regular}" FontFamily="FluentUI"
                         TextColor="{toolkit:AppThemeResource Primary}"
                         FontSize="48"
                         HorizontalOptions="Center" />
            <Label Text="{Binding MensajeError}"
                   TextColor="{toolkit:AppThemeResource PrimaryText}"
                   FontSize="14"
                   HorizontalTextAlignment="Center" />
            <Button Text="Reintentar"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{toolkit:AppThemeResource Primary}"
                    TextColor="{toolkit:AppThemeResource OnPrimary}"
                    CornerRadius="20"
                    Padding="24,8"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Spinner (overlay) -->
        <ActivityIndicator IsRunning="{Binding EstaCargando}"
                           IsVisible="{Binding EstaCargando}"
                           Color="{toolkit:AppThemeResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>

</ContentView>
