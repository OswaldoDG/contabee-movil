<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:ContaBeeMovil.Pages.Equipo"
               xmlns:f="clr-namespace:Fonts"
               x:Class="ContaBeeMovil.Views.VincularFormularioPopup"
               x:DataType="vm:VincularViewModel"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="CardBorder"
            BackgroundColor="{toolkit:AppThemeResource SecondaryBackground}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 16"
            Stroke="{toolkit:AppThemeResource Accent1}"
            StrokeThickness="1"
            Padding="20">
        <Border.Shadow>
            <Shadow Brush="{toolkit:AppThemeResource Shadow}" Offset="0,4" Radius="16" Opacity="0.4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="14">

            <Label Text="Vincular usuario"
                   FontAttributes="Bold"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="{toolkit:AppThemeResource PrimaryText}" />

            <BoxView HeightRequest="1"
                     BackgroundColor="{toolkit:AppThemeResource Accent1}"
                     Opacity="0.3" />

            <!-- Nombre -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{toolkit:AppThemeResource Alternate}"
                    Padding="12,8">
                <Entry Placeholder="Nombre"
                       Text="{Binding Nombre}"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       FontSize="15"
                       IsEnabled="{Binding NoCargando}" />
            </Border>

            <!-- Email opcional -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{toolkit:AppThemeResource Alternate}"
                    Padding="12,8">
                <Entry Placeholder="Correo Electrónico (Opcional)"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       FontSize="15"
                       IsEnabled="{Binding NoCargando}" />
            </Border>

            <!-- Teléfono opcional -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{toolkit:AppThemeResource Alternate}"
                    Padding="12,8">
                <Entry Placeholder="Teléfono (Opcional)"
                       Text="{Binding Telefono}"
                       Keyboard="Telephone"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{toolkit:AppThemeResource SecondaryText}"
                       TextColor="{toolkit:AppThemeResource PrimaryText}"
                       FontSize="15"
                       IsEnabled="{Binding NoCargando}" />
            </Border>

            <!-- Cargando -->
            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               IsVisible="{Binding EstaCargando}"
                               Color="{toolkit:AppThemeResource Primary}"
                               HorizontalOptions="Center"
                               HeightRequest="32" WidthRequest="32" />

            <!-- Botones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                <Button Text="Cancelar"
                        BackgroundColor="Transparent"
                        BorderColor="{toolkit:AppThemeResource Accent1}"
                        BorderWidth="1"
                        TextColor="{toolkit:AppThemeResource PrimaryText}"
                        CornerRadius="10"
                        HeightRequest="44"
                        IsEnabled="{Binding NoCargando}"
                        Clicked="OnCancelar" />
                <Button Grid.Column="1"
                        Text="Vincular"
                        Command="{Binding VincularCommand}"
                        IsEnabled="{Binding PuedeVincular}"
                        CornerRadius="10"
                        HeightRequest="44"
                        ContentLayout="Left,6"
                        FontAttributes="Bold">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FluentUIFilled"
                                         Glyph="{x:Static f:FluentUIFilled.link_person_20_filled}"
                                         Color="{toolkit:AppThemeResource PrimaryText}" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Primary}" />
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource PrimaryText}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Disabled}" />
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource SecondaryText}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
