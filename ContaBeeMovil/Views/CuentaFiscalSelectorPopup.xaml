<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:f="clr-namespace:Fonts"
               x:Class="ContaBeeMovil.Views.CuentaFiscalSelectorPopup"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Background="Transparent" >

    <Border BackgroundColor="{toolkit:AppThemeResource Background}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 10"
            Padding="20,24"
            WidthRequest="320">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.1" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="20">

            <Grid>
                <Label Text="Cuenta fiscal"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="20"
                       TextColor="{toolkit:AppThemeResource SecondaryText}" />

                <Grid HorizontalOptions="End"
                      VerticalOptions="Center"
                      WidthRequest="32"
                      HeightRequest="32">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefrescar" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="IconoRefrescar"
                           Text="{x:Static f:FluentUIFilled.arrow_clockwise_20_filled}"
                           FontFamily="FluentUIFilled"
                           FontSize="25"
                           TextColor="{toolkit:AppThemeResource Icon}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <ActivityIndicator x:Name="SpinnerRefrescar"
                                       IsVisible="False"
                                       IsRunning="True"
                                       Color="{toolkit:AppThemeResource Primary}"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                </Grid>
            </Grid>

            <Border BackgroundColor="{toolkit:AppThemeResource Alternate}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    Padding="1"
                    HorizontalOptions="Center"
                    WidthRequest="160"
                    HeightRequest="50">
                <Grid ColumnDefinitions="*,*" Padding="0">
                    <Border x:Name="BgRfc"
                            Grid.Column="0"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleRfc" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblRfc"
                               Text="RFC"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="10" />
                    </Border>
                    <Border x:Name="BgNombre"
                            Grid.Column="1"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleNombre" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblNombre"
                               Text="Nombre"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               FontSize="10" />
                    </Border>
                </Grid>
            </Border>
            <BoxView Style="{StaticResource Divider}" />

            <ScrollView MaximumHeightRequest="300">
                <VerticalStackLayout x:Name="PanelLista" Spacing="10" />
            </ScrollView>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
