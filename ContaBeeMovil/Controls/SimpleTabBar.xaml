<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ContaBeeMovil.Controls.SimpleTabBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    HeightRequest="54">

    <ContentView.Resources>
        <!-- Cada tab usa filas fijas (RowDefinitions="*,Auto,3" inline en cada Grid) para que
             el icono NO defina la altura: las métricas de FluentUI vs MaterialSymbols difieren
             en iOS y desplazaban el subrayado fuera del área visible del Border contenedor.
             Las RowDefinitions no van en el Style porque la colección se compartiría entre los
             5 tabs y arrastraría el alto calculado de uno a otro. -->
        <Style x:Key="TabContenedor" TargetType="Grid">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="RowSpacing" Value="1" />
            <Setter Property="Padding" Value="0,4,0,4" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>

        <Style x:Key="TabIcono" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HeightRequest" Value="26" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabTexto" TargetType="Label">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabSubrayado" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="3" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="End" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="TabsGrid"
          ColumnDefinitions="*,*,*,*,*"
          BackgroundColor="{toolkit:AppThemeResource Background}">

        <!-- Tab 0: Inicio -->
        <Grid Grid.Column="0"
              x:Name="TabInicio"
              RowDefinitions="*,Auto,3"
              Style="{StaticResource TabContenedor}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabInicio_Tapped" />
            </Grid.GestureRecognizers>
            <Label x:Name="IconInicio"
                   Grid.Row="0"
                   Style="{StaticResource TabIcono}"
                   Text="{x:Static f:FluentUIFilled.home_20_filled}"
                   FontFamily="FluentUIFilled"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <Label x:Name="LblInicio"
                   Grid.Row="1"
                   Style="{StaticResource TabTexto}"
                   Text="Inicio"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <BoxView x:Name="UnderlineInicio"
                     Grid.Row="2"
                     Style="{StaticResource TabSubrayado}"
                     Color="{toolkit:AppThemeResource Primary}"
                     IsVisible="True" />
        </Grid>

        <!-- Tab 1: Facturación -->
        <Grid Grid.Column="1"
              x:Name="TabFacturacion"
              RowDefinitions="*,Auto,3"
              Style="{StaticResource TabContenedor}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabFacturacion_Tapped" />
            </Grid.GestureRecognizers>
            <Label x:Name="IconFacturacion"
                   Grid.Row="0"
                   Style="{StaticResource TabIcono}"
                   Text="{x:Static f:MaterialSymbolsFilled.receipt}"
                   FontFamily="MaterialSymbolsFilled"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <Label x:Name="LblFacturacion"
                   Grid.Row="1"
                   Style="{StaticResource TabTexto}"
                   Text="Facturación"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <BoxView x:Name="UnderlineFacturacion"
                     Grid.Row="2"
                     Style="{StaticResource TabSubrayado}"
                     Color="{toolkit:AppThemeResource Primary}"
                     IsVisible="False" />
        </Grid>

        <!-- Tab 2: Devoluciones -->
        <Grid Grid.Column="2"
              x:Name="TabDevoluciones"
              RowDefinitions="*,Auto,3"
              Style="{StaticResource TabContenedor}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabDevoluciones_Tapped" />
            </Grid.GestureRecognizers>
            <Label x:Name="IconDevoluciones"
                   Grid.Row="0"
                   Style="{StaticResource TabIcono}"
                   Text="{x:Static f:MaterialSymbolsFilled.payment_arrow_down}"
                   FontFamily="MaterialSymbolsFilled"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <Label x:Name="LblDevoluciones"
                   Grid.Row="1"
                   Style="{StaticResource TabTexto}"
                   Text="Reembolsos"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <BoxView x:Name="UnderlineDevoluciones"
                     Grid.Row="2"
                     Style="{StaticResource TabSubrayado}"
                     Color="{toolkit:AppThemeResource Primary}"
                     IsVisible="False" />
        </Grid>

        <!-- Tab 3: Comprobaciones -->
        <Grid Grid.Column="3"
              x:Name="TabComprobaciones"
              RowDefinitions="*,Auto,3"
              Style="{StaticResource TabContenedor}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabComprobaciones_Tapped" />
            </Grid.GestureRecognizers>
            <Label x:Name="IconComprobaciones"
                   Grid.Row="0"
                   Style="{StaticResource TabIcono}"
                   Text="{x:Static f:MaterialSymbolsFilled.price_check}"
                   FontFamily="MaterialSymbolsFilled"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <Label x:Name="LblComprobaciones"
                   Grid.Row="1"
                   Style="{StaticResource TabTexto}"
                   Text="Comprobaciones"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <BoxView x:Name="UnderlineComprobaciones"
                     Grid.Row="2"
                     Style="{StaticResource TabSubrayado}"
                     Color="{toolkit:AppThemeResource Primary}"
                     IsVisible="False" />
        </Grid>

        <!-- Tab 4: Equipo -->
        <Grid Grid.Column="4"
              x:Name="TabEquipo"
              RowDefinitions="*,Auto,3"
              Style="{StaticResource TabContenedor}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabEquipo_Tapped" />
            </Grid.GestureRecognizers>
            <Label x:Name="IconEquipo"
                   Grid.Row="0"
                   Style="{StaticResource TabIcono}"
                   Text="{x:Static f:FluentUIFilled.people_20_filled}"
                   FontFamily="FluentUIFilled"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <Label x:Name="LblEquipo"
                   Grid.Row="1"
                   Style="{StaticResource TabTexto}"
                   Text="Equipo"
                   TextColor="{toolkit:AppThemeResource SecondaryIcon}" />
            <BoxView x:Name="UnderlineEquipo"
                     Grid.Row="2"
                     Style="{StaticResource TabSubrayado}"
                     Color="{toolkit:AppThemeResource Primary}"
                     IsVisible="False" />
        </Grid>

    </Grid>

</ContentView>
